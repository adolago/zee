{
  "$schema": "zee",
  "default_agent": "zee",
  "instructions": ["STYLE_GUIDE.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "memory": { "enabled": true },
    "calendar": { "enabled": true },
    "portfolio": { "enabled": true }
  },
  "memory": {
    "qdrant": {
      "url": "http://localhost:6333"
    },
    "embedding": {
      "apiKey": "{env:GEMINI_API_KEY}"
    }
  },
  "zee": {
    "splitwise": {
      "enabled": true,
      "token": "{env:SPLITWISE_TOKEN}"
    },
    "codexbar": {
      "enabled": true
    }
  },
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-4.7": {
          "options": {
            "thinking": { "type": "enabled", "budget_tokens": 32000, "clear_thinking": false }
          }
        }
      }
    },
    "xai": {
      "options": {
        "baseURL": "https://api.x.ai/v1"
      }
    },
    "vllm": {
      "options": {
        "baseURL": "http://192.168.178.102:8000/v1"
      }
    },
    "zee-model": {
      "options": {
        "baseURL": "http://192.168.178.102:8100/v1",
        "apiKey": "local"
      },
      "models": {
        "zee-qwen3-30b-phase5": {
          "id": "zee-qwen3-30b-phase5",
          "name": "Zee Qwen3-30B Phase 5",
          "family": "qwen",
          "release_date": "2026-02",
          "attachment": false,
          "reasoning": false,
          "temperature": true,
          "tool_call": false,
          "streaming": false,
          "limit": { "context": 4096, "output": 400 },
          "modalities": { "input": ["text"], "output": ["text"] },
          "options": {}
        }
      }
    }
  },
  "disabled_providers": ["zai", "zhipuai", "zhipuai-coding-plan", "cerebras", "kimi-for-coding"],
  "fallback": {
    "enabled": true,
    "rules": [
      {
        "condition": "rate_limit",
        "fallbacks": ["openai/gpt-5.4"]
      },
      {
        "condition": "error",
        "fallbacks": ["openai/gpt-5.4"]
      }
    ]
  },
  "skills": {
    "entries": {
      "whoopskill": {
        "enabled": true,
        "env": {
          "WHOOP_CLIENT_ID": "{env:WHOOP_CLIENT_ID}",
          "WHOOP_CLIENT_SECRET": "{env:WHOOP_CLIENT_SECRET}",
          "WHOOP_REDIRECT_URI": "http://localhost:8080/callback"
        }
      },
      "summarize": {
        "enabled": true,
        "env": {
          "GEMINI_API_KEY": "{env:GEMINI_API_KEY}"
        }
      },
      "spotify-player": {
        "enabled": true
      },
      "food-order": {
        "enabled": true
      },
      "coding-agent": {
        "enabled": true
      },
      "nano-pdf": {
        "enabled": true
      },
      "markdown-converter": {
        "enabled": true
      },
      "stock-market-pro": {
        "enabled": true
      },
      "news-digest": {
        "enabled": true
      },
      "tmux": {
        "enabled": true
      },
      "brave-search": {
        "disabled": true
      },
      "auto-updater": {
        "disabled": true
      },
      "clawddocs": {
        "disabled": true
      },
      "mcporter": {
        "disabled": true
      },
      "hooks-automation": {
        "enabled": true
      },
      "stream-chain": {
        "disabled": true
      },
      "self-improving-agent": {
        "enabled": true
      },
      "obsidian": {
        "disabled": true
      },
      "agent-browser": {
        "disabled": true
      },
      "home-assistant": {
        "apiKey": "{env:HASS_TOKEN}",
        "env": {
          "HASS_SERVER": "https://ha.home.arpa/"
        }
      }
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  },
  "tui": {
    "dictation": {
      "enabled": true,
      "model": "default",
      "region": "us-central1",
      "language": "en-US",
      "alternative_languages": ["pt-BR", "es-ES", "de-DE"]
    },
    "kitty_keyboard": false
  },
  "agent": {
    "zee": {
      "description": "Personal assistant for life admin, memory, messaging, and calendar",
      "mode": "primary",
      "color": "#5c9cf5"
    },

    "title": {
      "temperature": 0.5,
      "hidden": true
    },
    "compaction": {
      "temperature": 0.3,
      "hidden": true
    }
  }
}
