{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@zee/*": ["./packages/zee-core/src/*"],
      "@log": ["./packages/zee-core/src/util/log"],
      "@session/*": ["./packages/zee-core/src/session/*"],
      "@hooks/*": ["./packages/zee-core/src/hooks/*"],
      "@provider/*": ["./packages/zee-core/src/provider/*"],
      "@bus/*": ["./packages/zee-core/src/bus/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/*.d.ts"
  ]
}
