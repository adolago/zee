# Investing Environment Configuration
# Copy this file to .env and configure for your environment
#
# IMPORTANT: Never commit the .env file to version control!
# This file contains sensitive credentials.

# =============================================================================
# Environment
# =============================================================================
ZEE_INVESTING_ENV=development
# Options: development, staging, production

# =============================================================================
# API Configuration
# =============================================================================
ZEE_INVESTING_API_PORT=8000
ZEE_INVESTING_API_URL=http://localhost:8000

# =============================================================================
# Authentication & Security (Phase 0)
# =============================================================================

# JWT Configuration (REQUIRED)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZEE_INVESTING_AUTH_JWT_SECRET_KEY=your-secret-key-at-least-32-characters-long

# JWT algorithm (default: HS256)
# ZEE_INVESTING_AUTH_JWT_ALGORITHM=HS256

# Token expiration
# ZEE_INVESTING_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
# ZEE_INVESTING_AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key prefix for generated keys
# ZEE_INVESTING_AUTH_API_KEY_PREFIX=sk

# Password policy
# ZEE_INVESTING_AUTH_PASSWORD_MIN_LENGTH=8
# ZEE_INVESTING_AUTH_PASSWORD_REQUIRE_SPECIAL=true
# ZEE_INVESTING_AUTH_BCRYPT_ROUNDS=12

# Rate limiting (set to false to disable)
# ZEE_INVESTING_AUTH_RATE_LIMIT_ENABLED=true

# CORS origins (comma-separated for multiple origins)
# ZEE_INVESTING_AUTH_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Cookie settings (set COOKIE_SECURE=false for local development without HTTPS)
# ZEE_INVESTING_AUTH_COOKIE_SECURE=true
# ZEE_INVESTING_AUTH_COOKIE_HTTPONLY=true
# ZEE_INVESTING_AUTH_COOKIE_SAMESITE=lax

# =============================================================================
# Rate Limiting Configuration
# =============================================================================

# Market data endpoints (high frequency allowed)
# ZEE_INVESTING_RATE_MARKET_DATA_LIMIT=100
# ZEE_INVESTING_RATE_MARKET_DATA_WINDOW=60

# Analytics endpoints
# ZEE_INVESTING_RATE_ANALYTICS_LIMIT=30
# ZEE_INVESTING_RATE_ANALYTICS_WINDOW=60

# Research endpoints
# ZEE_INVESTING_RATE_RESEARCH_LIMIT=20
# ZEE_INVESTING_RATE_RESEARCH_WINDOW=60

# Accounting/SEC endpoints (lower limit for SEC courtesy)
# ZEE_INVESTING_RATE_ACCOUNTING_LIMIT=10
# ZEE_INVESTING_RATE_ACCOUNTING_WINDOW=60

# Default rate limit for other endpoints
# ZEE_INVESTING_RATE_DEFAULT_LIMIT=60
# ZEE_INVESTING_RATE_DEFAULT_WINDOW=60

# =============================================================================
# Database Configuration (Future phases)
# =============================================================================
POSTGRES_USER=investing
POSTGRES_PASSWORD=stanley_dev_password_change_me
POSTGRES_DB=investing
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration (Future phases - for session/cache)
# =============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty for development, set strong password for production

# =============================================================================
# External API Keys
# =============================================================================

# OpenBB Platform API Key
# Get from: https://my.openbb.co
OPENBB_API_KEY=

# SEC EDGAR Identity (required for SEC API access)
# Use your email address for SEC compliance
SEC_IDENTITY=your-email@example.com

# Options Flow Provider (optional)
OPTIONS_FLOW_API_KEY=

# Dark Pool Data Provider (optional)
DARK_POOL_API_KEY=

# Terrapin Finance API Key (for fixed income/bond data)
# Get from: https://terrapinfinance.com
TERRAPIN_API_KEY=

# =============================================================================
# Vector Search (Qdrant) Configuration
# =============================================================================

# Qdrant mode: memory, local, cloud
QDRANT_MODE=local

# For local mode - path to store data
QDRANT_PATH=~/.investing/qdrant

# For cloud mode - Qdrant Cloud URL and API key
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key

# Embedding configuration
# Provider: fastembed (default), openai, sentence-transformers
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# =============================================================================
# Production Settings
# =============================================================================

# SSL/TLS Configuration
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Domain Configuration
# DOMAIN=investing.example.com

# Log Level
# LOG_LEVEL=INFO
