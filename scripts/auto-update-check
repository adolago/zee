#!/usr/bin/env bash
#
# auto-update-check -- Check upstream remotes and notify via WhatsApp or Telegram.
#
# Runs check-upstream.sh --fetch, parses the output for BEHIND/DRIFT status,
# and sends a summary if any remote has new commits.
#
# Usage:
#   auto-update-check [--dry-run] [--always-notify]
#
# Environment:
#   ZEE_UPSTREAM_REPORTS_ENABLED  set true/1/yes/on to enable upstream notifications (default: false)
#   ZEE_NOTIFY_CHANNEL      messaging channel: whatsapp|telegram (default: whatsapp)
#   ZEE_WA_UPDATE_TO        WhatsApp recipient JID (default: 436649137379@s.whatsapp.net)
#   WACLI_BIN               path to wacli (default: /home/artur/go/bin/wacli)
#   WACLI_STORE             path to wacli store (default: ~/.wacli)
#   ZEE_TELEGRAM_UPDATE_TO  Telegram chat id
#   TELEGRAM_BOT_TOKEN      Telegram bot token

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

REPORTS_ENABLED_RAW="${ZEE_UPSTREAM_REPORTS_ENABLED:-false}"
REPORTS_ENABLED="$(printf '%s' "$REPORTS_ENABLED_RAW" | tr '[:upper:]' '[:lower:]')"
CHANNEL_RAW="${ZEE_NOTIFY_CHANNEL:-whatsapp}"
CHANNEL="$(printf '%s' "$CHANNEL_RAW" | tr '[:upper:]' '[:lower:]')"
WACLI_BIN="${WACLI_BIN:-/home/artur/go/bin/wacli}"
WACLI_STORE="${WACLI_STORE:-$HOME/.wacli}"
WA_TO="${ZEE_WA_UPDATE_TO:-436649137379@s.whatsapp.net}"
TG_TO="${ZEE_TELEGRAM_UPDATE_TO:-}"
TELEGRAM_BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"

DRY_RUN=false
ALWAYS_NOTIFY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run) DRY_RUN=true; shift ;;
        --always-notify) ALWAYS_NOTIFY=true; shift ;;
        *) echo "Unknown: $1"; exit 1 ;;
    esac
done

case "$REPORTS_ENABLED" in
    1|true|yes|on)
        ;;
    0|false|no|off|"")
        echo "Upstream notifications are disabled (set ZEE_UPSTREAM_REPORTS_ENABLED=true to enable)."
        exit 0
        ;;
    *)
        echo "Unsupported ZEE_UPSTREAM_REPORTS_ENABLED value: $REPORTS_ENABLED_RAW (expected true/false)." >&2
        exit 1
        ;;
esac

# Run check-upstream with fetch, strip ANSI colors
output=$(cd "$REPO_ROOT" && bash scripts/check-upstream.sh --fetch --verbose 2>&1 | sed 's/\x1b\[[0-9;]*m//g')

# Parse for behind counts
has_updates=false

while IFS= read -r line; do
    # Match lines like "  Behind: 42 (upstream changes)"
    if [[ "$line" =~ Behind:\ +([0-9]+) ]]; then
        count="${BASH_REMATCH[1]}"
        if [[ "$count" -gt 0 ]]; then
            has_updates=true
        fi
    fi
done <<< "$output"

# Also check for status lines
behind_remotes=()
current_remote=""

while IFS= read -r line; do
    if [[ "$line" =~ ^---\ (.+)\ \( ]]; then
        current_remote="${BASH_REMATCH[1]}"
    fi
    if [[ "$line" =~ Status:\ (MINOR\ DRIFT|SIGNIFICANT\ DRIFT|BEHIND) ]]; then
        behind_remotes+=("$current_remote")
    fi
done <<< "$output"

if ! $has_updates && ! $ALWAYS_NOTIFY; then
    echo "All remotes up to date. No notification sent."
    exit 0
fi

# Build message
if $has_updates; then
    msg="Zee upstream updates available."
    msg+=$'\n'
    msg+=$'\n'

    # Extract the relevant sections
    while IFS= read -r line; do
        # Include remote headers, behind/ahead counts, status, and commit lines
        if [[ "$line" =~ ^---\ |Behind:|Ahead:|Status:|Latest\ tag:|^\ \ \ \ [a-f0-9] ]]; then
            msg+="$line"
            msg+=$'\n'
        fi
    done <<< "$output"

    msg+=$'\n'
    msg+="Sync with: ./scripts/sync-upstream.sh --remote <name> --preview"
    msg+=$'\n'
    msg+="Rebuild with: ./scripts/reload.sh"
else
    msg="Zee upstream check: all remotes up to date."
fi

case "$CHANNEL" in
    whatsapp)
        notify_to="$WA_TO"
        ;;
    telegram)
        notify_to="$TG_TO"
        ;;
    *)
        echo "Unsupported ZEE_NOTIFY_CHANNEL value: $CHANNEL (expected whatsapp or telegram)" >&2
        exit 1
        ;;
esac

if $DRY_RUN; then
    echo "=== DRY RUN ==="
    echo "Channel: $CHANNEL"
    echo "To: $notify_to"
    echo "Message:"
    echo "$msg"
    exit 0
fi

send_whatsapp() {
    local to="$1"

    # wacli uses a store lock. The inbound bridge keeps sync running and can hold it.
    # Temporarily stop the bridge while we send this notification, then restore it.
    local bridge_was_active=false
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl --user is-active --quiet zee-wacli-bridge.service 2>/dev/null; then
            bridge_was_active=true
            systemctl --user stop zee-wacli-bridge.service >/dev/null 2>&1 || true
            sleep 2
        fi
    fi

    restore_bridge() {
        if $bridge_was_active; then
            systemctl --user start zee-wacli-bridge.service >/dev/null 2>&1 || true
        fi
    }

    trap restore_bridge EXIT

    "$WACLI_BIN" send text \
        --to "$to" \
        --message "$msg" \
        --store "$WACLI_STORE" \
        2>&1

    trap - EXIT
    restore_bridge
}

send_telegram() {
    local to="$1"
    local token="$2"
    if [[ -z "$to" ]]; then
        echo "ZEE_TELEGRAM_UPDATE_TO is required when ZEE_NOTIFY_CHANNEL=telegram" >&2
        exit 1
    fi
    if [[ -z "$token" ]]; then
        echo "TELEGRAM_BOT_TOKEN is required when ZEE_NOTIFY_CHANNEL=telegram" >&2
        exit 1
    fi
    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required for Telegram delivery" >&2
        exit 1
    fi

    local remaining="$msg"
    local max_len=3900
    while [[ -n "$remaining" ]]; do
        local chunk="${remaining:0:max_len}"
        if [[ ${#remaining} -le $max_len ]]; then
            remaining=""
        else
            remaining="${remaining:max_len}"
        fi
        curl -fsS -X POST "https://api.telegram.org/bot${token}/sendMessage" \
            --data-urlencode "chat_id=${to}" \
            --data-urlencode "text=${chunk}" \
            --data "allow_sending_without_reply=true" >/dev/null
    done
}

if [[ "$CHANNEL" == "whatsapp" ]]; then
    send_whatsapp "$WA_TO"
elif [[ "$CHANNEL" == "telegram" ]]; then
    send_telegram "$TG_TO" "$TELEGRAM_BOT_TOKEN"
else
    echo "Unsupported channel: $CHANNEL" >&2
    exit 1
fi

echo "Notification sent via $CHANNEL."
