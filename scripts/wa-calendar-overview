#!/usr/bin/env python3
"""
Send a morning or night calendar overview via WhatsApp or Telegram.

Morning: today's events.
Night:   tomorrow's events.

Usage:
  wa-calendar-overview --period morning [--channel whatsapp|telegram] [--to RECIPIENT] [--dry-run]
  wa-calendar-overview --period night   [--channel whatsapp|telegram] [--to RECIPIENT] [--dry-run]
  wa-calendar-overview --period morning --print-only
  wa-calendar-overview --period night   --print-only

Environment:
  ZEE_NOTIFY_CHANNEL      default channel (whatsapp|telegram)
  ZEE_WA_CALENDAR_TO      default WhatsApp recipient JID (e.g. 436649137379@s.whatsapp.net)
  ZEE_TELEGRAM_CALENDAR_TO default Telegram chat id
  ZEE_GOOGLE_CALENDAR_IDS comma-separated Google calendar IDs (default: primary)
  ZEE_CALENDAR_INCLUDE_TUWEL include TUWEL events by default (1/0)
  TELEGRAM_BOT_TOKEN      Telegram bot token
  WACLI_BIN               path to wacli binary  (default: /home/artur/go/bin/wacli)
  WACLI_STORE             path to wacli store   (default: /home/artur/.wacli)
  TUWEL_EMAIL             TUWEL login email/username
  TUWEL_PASSWORD          TUWEL login password
  TUWEL_BASE_URL          TUWEL base URL (default: https://tuwel.tuwien.ac.at)
"""

import argparse
import datetime as dt
import html
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.error
import urllib.request
from http.cookiejar import CookieJar
from pathlib import Path
from urllib.parse import urljoin

try:
    from zoneinfo import ZoneInfo
except Exception:  # pragma: no cover - zoneinfo exists in modern Python but keep fallback
    ZoneInfo = None  # type: ignore[assignment]

CALENDAR_API_BASE = "https://www.googleapis.com/calendar/v3"
DEFAULT_NOTIFY_CHANNEL = os.environ.get("ZEE_NOTIFY_CHANNEL", "whatsapp").strip().lower() or "whatsapp"
DEFAULT_TUWEL_BASE_URL = os.environ.get("TUWEL_BASE_URL", "https://tuwel.tuwien.ac.at").strip().rstrip("/")
DEFAULT_GOOGLE_CALENDAR_IDS = os.environ.get("ZEE_GOOGLE_CALENDAR_IDS", "").strip()
DEFAULT_INCLUDE_TUWEL = os.environ.get("ZEE_CALENDAR_INCLUDE_TUWEL", "").strip().lower() in {"1", "true", "yes", "on"}
TELEGRAM_MAX_TEXT = 4096

WACLI_BIN = os.environ.get("WACLI_BIN", "/home/artur/go/bin/wacli")
WACLI_STORE = os.environ.get("WACLI_STORE", "/home/artur/.wacli")


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def csv_values(raw: str) -> list[str]:
    values: list[str] = []
    for item in raw.split(","):
        value = item.strip()
        if value:
            values.append(value)
    return values


def local_timezone() -> dt.tzinfo:
    return dt.datetime.now().astimezone().tzinfo or dt.timezone.utc


def format_error_message(exc: Exception) -> str:
    message = str(exc).strip()
    return message if message else exc.__class__.__name__


# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------

def find_google_credentials_dir() -> Path:
    candidates = [
        Path.home() / ".config" / "zee" / "credentials" / "google",
        Path.home() / ".zee" / "credentials" / "google",
    ]
    for candidate in candidates:
        if (candidate / "oauth-client.json").exists() and (candidate / "tokens.json").exists():
            return candidate
    raise RuntimeError("Google credentials not found in ~/.config/zee/credentials/google or ~/.zee/credentials/google")


def load_google_auth() -> tuple[dict, dict, Path]:
    credentials_dir = find_google_credentials_dir()
    oauth_path = credentials_dir / "oauth-client.json"
    tokens_path = credentials_dir / "tokens.json"
    try:
        oauth_client = json.loads(oauth_path.read_text(encoding="utf-8"))
        tokens = json.loads(tokens_path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise RuntimeError(f"Failed to load Google credentials: {exc}") from exc
    return oauth_client, tokens, tokens_path


def refresh_access_token_if_needed(oauth_client: dict, tokens: dict, tokens_path: Path) -> str:
    expiry_date = int(tokens.get("expiry_date", 0))
    now_ms = int(dt.datetime.now(dt.timezone.utc).timestamp() * 1000)
    if now_ms < expiry_date - 5 * 60 * 1000 and tokens.get("access_token"):
        return tokens["access_token"]

    installed = oauth_client.get("installed", {})
    payload = urllib.parse.urlencode({
        "client_id": installed.get("client_id", ""),
        "client_secret": installed.get("client_secret", ""),
        "refresh_token": tokens.get("refresh_token", ""),
        "grant_type": "refresh_token",
    }).encode("utf-8")

    request = urllib.request.Request(
        installed.get("token_uri", "https://oauth2.googleapis.com/token"),
        data=payload,
        method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            token_payload = json.loads(response.read().decode("utf-8"))
    except Exception as exc:
        raise RuntimeError(f"Failed to refresh Google token: {exc}") from exc

    access_token = token_payload.get("access_token")
    expires_in = int(token_payload.get("expires_in", 3600))
    if not access_token:
        raise RuntimeError("Google token refresh returned no access token")

    tokens["access_token"] = access_token
    tokens["expiry_date"] = now_ms + expires_in * 1000
    try:
        tokens_path.write_text(json.dumps(tokens, indent=2), encoding="utf-8")
    except Exception as exc:
        raise RuntimeError(f"Failed to persist refreshed Google token: {exc}") from exc
    return access_token


def google_get(endpoint: str, access_token: str, params: dict[str, str] | None = None) -> dict:
    endpoint_path = endpoint if endpoint.startswith("/") else f"/{endpoint}"
    url = f"{CALENDAR_API_BASE}{endpoint_path}"
    if params:
        url = f"{url}?{urllib.parse.urlencode(params)}"
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {access_token}"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception as exc:
        raise RuntimeError(f"Google Calendar request failed: {exc}") from exc


def resolve_calendar_name(calendar_id: str, access_token: str) -> str:
    if calendar_id != "primary":
        try:
            payload = google_get(f"/calendars/{urllib.parse.quote(calendar_id, safe='')}", access_token)
            summary = payload.get("summary")
            if isinstance(summary, str) and summary.strip():
                return summary.strip()
        except Exception:
            pass
        return calendar_id

    try:
        payload = google_get("/users/me/calendarList", access_token)
        for item in payload.get("items", []):
            if item.get("primary"):
                summary = item.get("summary")
                if isinstance(summary, str) and summary.strip():
                    return summary.strip()
                return "Primary"
    except Exception:
        pass
    return "Primary"


def list_events(calendar_id: str, access_token: str, start_iso: str, end_iso: str, max_results: int) -> list[dict]:
    payload = google_get(
        f"/calendars/{urllib.parse.quote(calendar_id, safe='')}/events",
        access_token,
        {
            "timeMin": start_iso,
            "timeMax": end_iso,
            "singleEvents": "true",
            "orderBy": "startTime",
            "maxResults": str(max_results),
        },
    )
    return payload.get("items", [])


# ---------------------------------------------------------------------------
# TUWEL
# ---------------------------------------------------------------------------

def http_get_text(
    opener: urllib.request.OpenerDirector,
    url: str,
    *,
    timeout: int = 30,
    headers: dict[str, str] | None = None,
) -> tuple[str, str]:
    request = urllib.request.Request(url, headers=headers or {})
    try:
        with opener.open(request, timeout=timeout) as response:
            body = response.read().decode("utf-8", errors="replace")
            return body, response.geturl()
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {exc.code} for {url}: {body[:240]}") from exc
    except Exception as exc:
        raise RuntimeError(f"GET failed for {url}: {exc}") from exc


def http_post_form_text(
    opener: urllib.request.OpenerDirector,
    url: str,
    payload: dict[str, str],
    *,
    timeout: int = 30,
) -> tuple[str, str]:
    encoded = urllib.parse.urlencode(payload).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=encoded,
        method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    try:
        with opener.open(request, timeout=timeout) as response:
            body = response.read().decode("utf-8", errors="replace")
            return body, response.geturl()
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {exc.code} for {url}: {body[:240]}") from exc
    except Exception as exc:
        raise RuntimeError(f"POST failed for {url}: {exc}") from exc


def http_post_json(
    opener: urllib.request.OpenerDirector,
    url: str,
    payload: list[dict],
    *,
    timeout: int = 30,
) -> list | dict:
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        method="POST",
        headers={"Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest"},
    )
    try:
        with opener.open(request, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {exc.code} for {url}: {body[:240]}") from exc
    except Exception as exc:
        raise RuntimeError(f"POST JSON failed for {url}: {exc}") from exc


def extract_attr(tag: str, attr: str) -> str | None:
    match = re.search(rf'{attr}\s*=\s*["\']([^"\']*)["\']', tag, flags=re.IGNORECASE)
    if match:
        return html.unescape(match.group(1))
    match = re.search(rf"{attr}\s*=\s*([^\s>]+)", tag, flags=re.IGNORECASE)
    if match:
        return html.unescape(match.group(1).strip())
    return None


def extract_hidden_inputs(page_html: str) -> dict[str, str]:
    fields: dict[str, str] = {}
    for match in re.finditer(r"<input\b[^>]*>", page_html, flags=re.IGNORECASE):
        tag = match.group(0)
        name = extract_attr(tag, "name")
        if not name:
            continue
        input_type = (extract_attr(tag, "type") or "").strip().lower()
        if input_type and input_type != "hidden":
            continue
        value = extract_attr(tag, "value") or ""
        fields[name] = value
    return fields


def extract_first_group(pattern: str, text: str) -> str | None:
    match = re.search(pattern, text, flags=re.IGNORECASE)
    if not match:
        return None
    value = match.group(1).strip()
    return html.unescape(value) if value else None


def extract_tuwel_export_url(page_html: str, base_url: str) -> str | None:
    raw_match = extract_first_group(r'(calendar/export_execute\.php[^"\'>\s]+)', page_html)
    if not raw_match:
        return None
    return urljoin(base_url + "/", raw_match)


def extract_tuwel_user_id(page_html: str) -> str | None:
    for pattern in (
        r'name=["\']userid["\']\s+value=["\'](\d+)["\']',
        r"/user/profile\.php\?id=(\d+)",
        r'"userid"\s*:\s*(\d+)',
    ):
        value = extract_first_group(pattern, page_html)
        if value:
            return value
    return None


def extract_tuwel_sesskey(page_html: str) -> str | None:
    return extract_first_group(r'sesskey["\']?\s*[:=]\s*["\']([a-zA-Z0-9]+)["\']', page_html)


def extract_tuwel_token(page_html: str) -> str | None:
    for pattern in (
        r'name=["\']authtoken["\']\s+value=["\']([^"\']+)["\']',
        r'"authtoken"\s*:\s*"([^"]+)"',
    ):
        value = extract_first_group(pattern, page_html)
        if value:
            return value
    return None


def build_tuwel_ics_url(base_url: str, user_id: str, token: str) -> str:
    query = urllib.parse.urlencode(
        {
            "userid": user_id,
            "authtoken": token,
            "preset_what": "all",
            "preset_time": "recentupcoming",
        }
    )
    return f"{base_url}/calendar/export_execute.php?{query}"


def get_tuwel_export_token(opener: urllib.request.OpenerDirector, base_url: str, sesskey: str) -> str:
    ajax_url = f"{base_url}/lib/ajax/service.php?sesskey={urllib.parse.quote(sesskey)}&info=core_calendar_get_calendar_export_token"
    payload = [{"index": 0, "methodname": "core_calendar_get_calendar_export_token", "args": {}}]
    response = http_post_json(opener, ajax_url, payload)
    if isinstance(response, list):
        for item in response:
            if not isinstance(item, dict):
                continue
            data = item.get("data")
            if isinstance(data, dict):
                token = data.get("token")
                if isinstance(token, str) and token.strip():
                    return token.strip()
            if item.get("error") and isinstance(item.get("exception"), dict):
                message = item["exception"].get("message")
                if isinstance(message, str) and message.strip():
                    raise RuntimeError(f"TUWEL token request failed: {message.strip()}")
    raise RuntimeError("TUWEL token request returned no token")


def obtain_tuwel_ics_url(opener: urllib.request.OpenerDirector, base_url: str, dashboard_html: str) -> str:
    export_html, _ = http_get_text(opener, f"{base_url}/calendar/export.php")
    export_url = extract_tuwel_export_url(export_html, base_url)
    if export_url:
        return export_url

    user_id = extract_tuwel_user_id(export_html) or extract_tuwel_user_id(dashboard_html)
    token = extract_tuwel_token(export_html)
    if user_id and token:
        return build_tuwel_ics_url(base_url, user_id, token)

    sesskey = extract_tuwel_sesskey(export_html) or extract_tuwel_sesskey(dashboard_html)
    if user_id and sesskey:
        token = get_tuwel_export_token(opener, base_url, sesskey)
        return build_tuwel_ics_url(base_url, user_id, token)

    raise RuntimeError("Unable to locate TUWEL calendar export URL/token")


def fetch_tuwel_ics(base_url: str, email: str, password: str) -> str:
    if not email.strip():
        raise RuntimeError("TUWEL_EMAIL is empty")
    if not password.strip():
        raise RuntimeError("TUWEL_PASSWORD is empty")

    cookie_jar = CookieJar()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cookie_jar))
    login_url = f"{base_url}/login/index.php"

    login_page, _ = http_get_text(opener, login_url)
    form_data = extract_hidden_inputs(login_page)
    form_data["username"] = email
    form_data["password"] = password
    _, post_url = http_post_form_text(opener, login_url, form_data)

    dashboard_html, dashboard_url = http_get_text(opener, f"{base_url}/my/")
    if "/login/index.php" in dashboard_url or "/login/index.php" in post_url:
        raise RuntimeError("TUWEL login failed (redirected back to login)")

    ics_url = obtain_tuwel_ics_url(opener, base_url, dashboard_html)
    ics_text, final_ics_url = http_get_text(opener, ics_url)
    if "/login/index.php" in final_ics_url:
        raise RuntimeError("TUWEL calendar export redirected to login")
    if "BEGIN:VCALENDAR" not in ics_text:
        snippet = ics_text.strip()[:200]
        raise RuntimeError(f"TUWEL calendar export did not return ICS data: {snippet}")
    return ics_text


def unfold_ics_lines(ics_text: str) -> list[str]:
    unfolded: list[str] = []
    for raw_line in ics_text.splitlines():
        line = raw_line.rstrip("\r\n")
        if (line.startswith(" ") or line.startswith("\t")) and unfolded:
            unfolded[-1] += line[1:]
        else:
            unfolded.append(line)
    return unfolded


def parse_ics_field(field_name: str) -> tuple[str, dict[str, str]]:
    parts = field_name.split(";")
    key = parts[0].upper()
    params: dict[str, str] = {}
    for part in parts[1:]:
        if "=" not in part:
            continue
        name, value = part.split("=", 1)
        params[name.upper()] = value.strip().strip('"')
    return key, params


def parse_ics_datetime(value: str, params: dict[str, str], local_tz: dt.tzinfo) -> dt.datetime | dt.date | None:
    trimmed = value.strip()
    if not trimmed:
        return None

    if re.fullmatch(r"\d{8}", trimmed):
        try:
            return dt.datetime.strptime(trimmed, "%Y%m%d").date()
        except ValueError:
            return None

    is_utc = trimmed.endswith("Z")
    body = trimmed[:-1] if is_utc else trimmed

    parsed: dt.datetime | None = None
    for fmt in ("%Y%m%dT%H%M%S", "%Y%m%dT%H%M"):
        try:
            parsed = dt.datetime.strptime(body, fmt)
            break
        except ValueError:
            continue
    if parsed is None:
        return None

    if is_utc:
        return parsed.replace(tzinfo=dt.timezone.utc)

    tzid = params.get("TZID")
    if tzid and ZoneInfo is not None:
        try:
            tz = ZoneInfo(tzid)
            return parsed.replace(tzinfo=tz)
        except Exception:
            pass
    return parsed.replace(tzinfo=local_tz)


def decode_ics_text(value: str) -> str:
    decoded = value
    decoded = decoded.replace(r"\n", "\n").replace(r"\N", "\n")
    decoded = decoded.replace(r"\,", ",").replace(r"\;", ";").replace(r"\\", "\\")
    return decoded.strip()


def parse_ics_events(ics_text: str, local_tz: dt.tzinfo) -> list[dict]:
    events: list[dict] = []
    current: dict[str, tuple[str, dict[str, str]]] | None = None

    for line in unfold_ics_lines(ics_text):
        if line == "BEGIN:VEVENT":
            current = {}
            continue
        if line == "END:VEVENT":
            if current is not None:
                event = event_from_ics_component(current, local_tz)
                if event is not None:
                    events.append(event)
            current = None
            continue
        if current is None:
            continue
        if ":" not in line:
            continue
        field_name, raw_value = line.split(":", 1)
        key, params = parse_ics_field(field_name)
        current[key] = (raw_value, params)

    return events


def event_from_ics_component(component: dict[str, tuple[str, dict[str, str]]], local_tz: dt.tzinfo) -> dict | None:
    start_raw = component.get("DTSTART")
    if not start_raw:
        return None

    start_value = parse_ics_datetime(start_raw[0], start_raw[1], local_tz)
    if start_value is None:
        return None

    end_raw = component.get("DTEND")
    end_value = parse_ics_datetime(end_raw[0], end_raw[1], local_tz) if end_raw else None
    summary_raw = component.get("SUMMARY", ("(No title)", {}))[0]
    location_raw = component.get("LOCATION", ("", {}))[0]

    summary = decode_ics_text(summary_raw) or "(No title)"
    location = decode_ics_text(location_raw)
    event: dict = {"summary": summary, "start": {}, "end": {}}

    if location:
        event["location"] = location

    if isinstance(start_value, dt.date) and not isinstance(start_value, dt.datetime):
        start_date = start_value
        if isinstance(end_value, dt.date) and not isinstance(end_value, dt.datetime):
            end_date = end_value
        else:
            end_date = start_date + dt.timedelta(days=1)
        event["start"]["date"] = start_date.isoformat()
        event["end"]["date"] = end_date.isoformat()
        return event

    if not isinstance(start_value, dt.datetime):
        return None
    if isinstance(end_value, dt.datetime):
        end_dt = end_value
    else:
        end_dt = start_value + dt.timedelta(hours=1)
    event["start"]["dateTime"] = start_value.isoformat()
    event["end"]["dateTime"] = end_dt.isoformat()
    return event


def event_overlaps_day(event: dict, day_start: dt.datetime, day_end: dt.datetime, target_day: dt.date) -> bool:
    start = event.get("start", {})
    end = event.get("end", {})

    if isinstance(start, dict) and start.get("date"):
        try:
            start_date = dt.date.fromisoformat(start["date"])
        except Exception:
            return False
        end_date_raw = end.get("date") if isinstance(end, dict) else None
        try:
            end_date = dt.date.fromisoformat(end_date_raw) if isinstance(end_date_raw, str) else start_date + dt.timedelta(days=1)
        except Exception:
            end_date = start_date + dt.timedelta(days=1)
        return start_date < (target_day + dt.timedelta(days=1)) and end_date > target_day

    start_dt = parse_event_datetime(start.get("dateTime") if isinstance(start, dict) else None)
    end_dt = parse_event_datetime(end.get("dateTime") if isinstance(end, dict) else None)
    if start_dt is None:
        return False
    if end_dt is None:
        end_dt = start_dt + dt.timedelta(hours=1)
    return start_dt < day_end and end_dt > day_start


def fetch_tuwel_events_for_day(
    *,
    base_url: str,
    email: str,
    password: str,
    day_start: dt.datetime,
    day_end: dt.datetime,
    target_day: dt.date,
    max_events: int,
) -> list[dict]:
    ics_text = fetch_tuwel_ics(base_url, email, password)
    events = parse_ics_events(ics_text, day_start.tzinfo or local_timezone())
    filtered = [event for event in events if event_overlaps_day(event, day_start, day_end, target_day)]
    filtered.sort(key=event_sort_key)
    return filtered[:max_events]


# ---------------------------------------------------------------------------
# Message formatting
# ---------------------------------------------------------------------------

def parse_event_datetime(value: str | None) -> dt.datetime | None:
    if not value:
        return None
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    try:
        return dt.datetime.fromisoformat(value)
    except ValueError:
        return None


def event_sort_key(event: dict) -> tuple[int, dt.datetime, str]:
    title = str(event.get("summary", "")).lower()
    start = event.get("start", {})
    if isinstance(start, dict) and start.get("date"):
        try:
            day = dt.date.fromisoformat(start["date"])
        except Exception:
            day = dt.date.today()
        return (0, dt.datetime.combine(day, dt.time.min).replace(tzinfo=local_timezone()), title)
    start_dt = parse_event_datetime(start.get("dateTime") if isinstance(start, dict) else None)
    if start_dt is None:
        return (2, dt.datetime.now(tz=local_timezone()), title)
    return (1, start_dt, title)


def format_event_line(event: dict) -> str:
    title = event.get("summary") or "(No title)"
    location = event.get("location")
    start = event.get("start", {})
    end = event.get("end", {})

    if start.get("date"):
        line = f"- All day: {title}"
    else:
        start_dt = parse_event_datetime(start.get("dateTime"))
        end_dt = parse_event_datetime(end.get("dateTime"))
        if start_dt and end_dt:
            line = f"- {start_dt.astimezone().strftime('%H:%M')}-{end_dt.astimezone().strftime('%H:%M')}: {title}"
        elif start_dt:
            line = f"- {start_dt.astimezone().strftime('%H:%M')}: {title}"
        else:
            line = f"- {title}"

    if location:
        line = f"{line} ({location})"
    return line


def build_message(period: str, sources: list[dict], target_day: dt.date, source_errors: list[str]) -> str:
    header_date = target_day.strftime("%A, %d %b %Y")

    if period == "morning":
        lead = f"Good morning. Calendar for {header_date}."
    else:
        lead = f"Good night. Calendar for {header_date}."

    lines = [lead]

    total = sum(len(source.get("events", [])) for source in sources)
    if sources:
        lines.append(f"Total: {total} event(s) across {len(sources)} source(s).")
    else:
        lines.append("No events scheduled.")

    for source in sources:
        label = str(source.get("label", "Calendar")).strip() or "Calendar"
        events = source.get("events", [])
        lines.append("")
        lines.append(f"{label}:")
        if not events:
            lines.append("No events scheduled.")
            continue
        lines.append(f"{len(events)} event(s):")
        for event in events:
            lines.append(format_event_line(event))

    if source_errors:
        lines.append("")
        lines.append("Source status:")
        for error in source_errors:
            lines.append(f"- {error}")

    return "\n".join(lines)


# ---------------------------------------------------------------------------
# wacli send
# ---------------------------------------------------------------------------

def resolve_recipient(explicit_to: str | None, channel: str) -> str:
    if explicit_to:
        return explicit_to
    if channel == "telegram":
        env_to = os.environ.get("ZEE_TELEGRAM_CALENDAR_TO", "").strip()
    else:
        env_to = os.environ.get("ZEE_WA_CALENDAR_TO", "").strip()
    if env_to:
        return env_to
    if channel == "telegram":
        fail("No recipient configured. Pass --to or set ZEE_TELEGRAM_CALENDAR_TO.")
    fail("No recipient configured. Pass --to or set ZEE_WA_CALENDAR_TO.")


def normalize_wacli_lock() -> None:
    """Clear stale wacli store lock if present."""
    try:
        result = subprocess.run(
            [WACLI_BIN, "doctor", "--json", "--store", WACLI_STORE],
            capture_output=True, text=True, timeout=10,
        )
        diag = json.loads(result.stdout) if result.stdout.strip() else {}
        data = diag.get("data", {})
        if data.get("lock_held"):
            lock_file = Path(WACLI_STORE) / "LOCK"
            lock_file.unlink(missing_ok=True)
    except Exception:
        pass


def send_whatsapp(recipient: str, message: str, dry_run: bool) -> None:
    if dry_run:
        print(f"[dry-run] Would send to {recipient}:")
        print(message)
        return

    normalize_wacli_lock()

    # Ensure recipient is a JID
    jid = recipient
    digits = "".join(c for c in recipient if c.isdigit())
    if "@" not in jid and digits:
        jid = f"{digits}@s.whatsapp.net"

    command = [
        WACLI_BIN, "send", "text",
        "--to", jid,
        "--message", message,
        "--store", WACLI_STORE,
        "--timeout", "2m",
        "--json",
    ]

    max_attempts = 3
    last_error = ""

    for attempt in range(1, max_attempts + 1):
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=180)
            if result.returncode == 0:
                if result.stdout.strip():
                    print(result.stdout.strip())
                return
            last_error = (result.stderr.strip() or result.stdout.strip() or f"exit code {result.returncode}")
        except subprocess.TimeoutExpired:
            last_error = "wacli send timed out after 180s"
        except Exception as exc:
            last_error = str(exc)

        if attempt < max_attempts:
            # Try sync refresh before retry
            try:
                subprocess.run(
                    [WACLI_BIN, "sync", "--once", "--idle-exit", "5s",
                     "--refresh-contacts", "--store", WACLI_STORE, "--timeout", "30s"],
                    capture_output=True, timeout=60,
                )
            except Exception:
                pass
            normalize_wacli_lock()

    fail(f"WhatsApp send failed after {max_attempts} attempts. Last error: {last_error}")


def chunk_text(text: str, max_len: int = TELEGRAM_MAX_TEXT) -> list[str]:
    if len(text) <= max_len:
        return [text]

    chunks: list[str] = []
    remaining = text
    while len(remaining) > max_len:
        idx = remaining.rfind("\n", 0, max_len + 1)
        if idx < (max_len // 2):
            idx = max_len
        chunk = remaining[:idx].rstrip()
        if not chunk:
            chunk = remaining[:max_len]
            idx = len(chunk)
        chunks.append(chunk)
        remaining = remaining[idx:].lstrip("\n")
    if remaining:
        chunks.append(remaining)
    return chunks


def send_telegram(recipient: str, message: str, dry_run: bool) -> None:
    token = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    if not token:
        fail("TELEGRAM_BOT_TOKEN is required for Telegram delivery.")

    if dry_run:
        print(f"[dry-run] Would send to Telegram chat {recipient}:")
        print(message)
        return

    url = f"https://api.telegram.org/bot{token}/sendMessage"
    for chunk in chunk_text(message):
        payload = {
            "chat_id": recipient,
            "text": chunk,
            "allow_sending_without_reply": True,
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            method="POST",
            headers={"Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as response:
                raw = response.read().decode("utf-8")
        except Exception as exc:
            fail(f"Telegram send failed: {exc}")

        try:
            data = json.loads(raw)
        except Exception as exc:
            fail(f"Telegram returned invalid JSON: {exc}")

        if not data.get("ok"):
            fail(f"Telegram send failed: {data.get('description', 'unknown error')}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(description="Send morning/night calendar overview via WhatsApp or Telegram")
    parser.add_argument("--period", choices=["morning", "night"], required=True)
    parser.add_argument("--channel", choices=["whatsapp", "telegram"], default=DEFAULT_NOTIFY_CHANNEL)
    parser.add_argument("--to", dest="recipient", default=None, help="Recipient JID/phone number or Telegram chat id")
    parser.add_argument("--calendar-id", default=None, help="Deprecated alias for a single Google calendar id")
    parser.add_argument("--google-calendar-id", action="append", dest="google_calendar_ids", default=[], help="Google calendar id (repeatable)")
    parser.add_argument("--max-events", type=int, default=12)
    parser.add_argument("--tuwel-max-events", type=int, default=None)
    parser.add_argument("--include-tuwel", dest="include_tuwel", action="store_true", default=DEFAULT_INCLUDE_TUWEL)
    parser.add_argument("--no-include-tuwel", dest="include_tuwel", action="store_false")
    parser.add_argument("--tu-only", action="store_true", help="Only include TUWEL events in the digest")
    parser.add_argument("--tuwel-base-url", default=DEFAULT_TUWEL_BASE_URL)
    parser.add_argument("--print-only", action="store_true", help="Print message to stdout and skip delivery")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    now = dt.datetime.now().astimezone()

    if args.period == "morning":
        target_day = now.date()
    else:
        target_day = (now + dt.timedelta(days=1)).date()

    start_dt = dt.datetime.combine(target_day, dt.time.min, tzinfo=now.tzinfo)
    end_dt = start_dt + dt.timedelta(days=1)
    tuwel_max_events = args.tuwel_max_events if args.tuwel_max_events is not None else args.max_events

    google_ids: list[str]
    if args.google_calendar_ids:
        google_ids = [value.strip() for value in args.google_calendar_ids if value.strip()]
    elif isinstance(args.calendar_id, str) and args.calendar_id.strip():
        google_ids = [args.calendar_id.strip()]
    elif DEFAULT_GOOGLE_CALENDAR_IDS:
        google_ids = csv_values(DEFAULT_GOOGLE_CALENDAR_IDS)
    else:
        google_ids = ["primary"]

    include_tuwel = bool(args.include_tuwel or args.tu_only)
    source_errors: list[str] = []
    sources: list[dict] = []

    if not args.tu_only:
        try:
            oauth_client, tokens, tokens_path = load_google_auth()
            access_token = refresh_access_token_if_needed(oauth_client, tokens, tokens_path)
            for calendar_id in google_ids:
                try:
                    calendar_name = resolve_calendar_name(calendar_id, access_token)
                    events = list_events(calendar_id, access_token, start_dt.isoformat(), end_dt.isoformat(), args.max_events)
                    events.sort(key=event_sort_key)
                    sources.append({"label": f"Google ({calendar_name})", "events": events})
                except Exception as exc:
                    source_errors.append(f"Google ({calendar_id}) unavailable: {format_error_message(exc)}")
        except Exception as exc:
            source_errors.append(f"Google unavailable: {format_error_message(exc)}")

    if include_tuwel:
        tuwel_email = os.environ.get("TUWEL_EMAIL", "")
        tuwel_password = os.environ.get("TUWEL_PASSWORD", "")
        try:
            tuwel_events = fetch_tuwel_events_for_day(
                base_url=args.tuwel_base_url.strip().rstrip("/"),
                email=tuwel_email,
                password=tuwel_password,
                day_start=start_dt,
                day_end=end_dt,
                target_day=target_day,
                max_events=tuwel_max_events,
            )
            sources.append({"label": "TUWEL", "events": tuwel_events})
        except Exception as exc:
            source_errors.append(f"TUWEL unavailable: {format_error_message(exc)}")

    if not sources and source_errors:
        fail(f"All calendar sources failed: {' | '.join(source_errors)}")

    message = build_message(args.period, sources, target_day, source_errors)
    if args.print_only:
        print(message)
        return

    recipient = resolve_recipient(args.recipient, args.channel)
    if args.channel == "telegram":
        send_telegram(recipient, message, args.dry_run)
    else:
        send_whatsapp(recipient, message, args.dry_run)


if __name__ == "__main__":
    main()
