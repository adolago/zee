#!/usr/bin/env python3
"""
telegram-bridge -- Long-poll Telegram bot bridge for Zee.

Architecture:
  1. Poll Telegram Bot API (`getUpdates`) for inbound chat messages.
  2. Map each Telegram chat to a persistent Zee session.
  3. Forward message text to Zee via `POST /session/:sessionID/message`.
  4. Send Zee's text response back to Telegram (`sendMessage`).

Key commands:
  /start   Show usage and bot status
  /help    Show usage
  /new     Start a new Zee session for this chat
  /reset   Alias for /new
  /session Show current Zee session id
  /calendar_today     Render today's combined calendar digest
  /calendar_tomorrow  Render tomorrow's combined calendar digest
  /calendar_morning   Alias for /calendar_today
  /calendar_night     Alias for /calendar_tomorrow

Environment:
  TELEGRAM_BOT_TOKEN               required (Telegram bot token)
  ZEE_API_URL                      default: http://127.0.0.1:3210
  ZEE_TELEGRAM_AGENT               default: zee
  ZEE_TELEGRAM_SESSION_SURFACE     default: telegram (api|whatsapp|telegram)
  ZEE_TELEGRAM_SESSION_MODE        default: accept (plan|accept|bypass)
  ZEE_TELEGRAM_STATE               default: ~/.local/state/zee/telegram-bridge.json
  ZEE_TELEGRAM_POLL_TIMEOUT        default: 30
  ZEE_TELEGRAM_ALLOWED_CHAT_IDS    optional CSV allowlist of numeric chat IDs
  ZEE_TELEGRAM_MAX_REPLY_CHUNKS    default: 4
  ZEE_TELEGRAM_MAX_REPLY_CHARS     default: 12000
  ZEE_TELEGRAM_CALENDAR_SCRIPT     default: scripts/wa-calendar-overview
  ZEE_TELEGRAM_CALENDAR_TIMEOUT    default: 75
  ZEE_TELEGRAM_CALENDAR_PYTHON     default: current python executable
  ZEE_API_TOKEN                    optional Bearer token for Zee API auth
"""

import argparse
import contextlib
import json
import logging
import os
import re
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
import urllib.parse
from pathlib import Path

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

DEFAULT_ZEE_API_URL = os.environ.get("ZEE_API_URL", "http://127.0.0.1:3210").rstrip("/")
DEFAULT_AGENT = os.environ.get("ZEE_TELEGRAM_AGENT", "zee")
DEFAULT_SESSION_SURFACE = os.environ.get("ZEE_TELEGRAM_SESSION_SURFACE", "telegram")
DEFAULT_SESSION_MODE = os.environ.get("ZEE_TELEGRAM_SESSION_MODE", "accept").strip().lower()
DEFAULT_MODEL_PROVIDER = os.environ.get("ZEE_TELEGRAM_MODEL_PROVIDER", "").strip()
DEFAULT_MODEL_ID = os.environ.get("ZEE_TELEGRAM_MODEL_ID", "").strip()
DEFAULT_STATE_PATH = os.environ.get(
    "ZEE_TELEGRAM_STATE",
    str(Path.home() / ".local" / "state" / "zee" / "telegram-bridge.json"),
)
DEFAULT_POLL_TIMEOUT = int(os.environ.get("ZEE_TELEGRAM_POLL_TIMEOUT", "30"))
DEFAULT_ALLOWED_CHAT_IDS = os.environ.get("ZEE_TELEGRAM_ALLOWED_CHAT_IDS", "")
DEFAULT_ZEE_API_TOKEN = os.environ.get("ZEE_API_TOKEN", "").strip()
DEFAULT_MAX_REPLY_CHUNKS = int(os.environ.get("ZEE_TELEGRAM_MAX_REPLY_CHUNKS", "4"))
DEFAULT_MAX_REPLY_CHARS = int(os.environ.get("ZEE_TELEGRAM_MAX_REPLY_CHARS", "12000"))
DEFAULT_MESSAGE_TIMEOUT = int(os.environ.get("ZEE_TELEGRAM_MESSAGE_TIMEOUT", "90"))
DEFAULT_PREFER_IPV4 = os.environ.get("ZEE_TELEGRAM_PREFER_IPV4", "1").strip().lower() not in {"0", "false", "no"}
DEFAULT_CALENDAR_SCRIPT = os.environ.get(
    "ZEE_TELEGRAM_CALENDAR_SCRIPT",
    str(Path(__file__).resolve().with_name("wa-calendar-overview")),
).strip()
DEFAULT_CALENDAR_TIMEOUT = int(os.environ.get("ZEE_TELEGRAM_CALENDAR_TIMEOUT", "75"))
DEFAULT_CALENDAR_PYTHON = os.environ.get("ZEE_TELEGRAM_CALENDAR_PYTHON", sys.executable or "python3").strip()

TELEGRAM_MAX_TEXT = 4096
THOUGHT_BLOCK_RE = re.compile(r"!\[thought[\s\S]*?\](?:!|$)", re.IGNORECASE)
THINK_TAG_RE = re.compile(r"<think(?:ing)?[\s\S]*?</think(?:ing)?>", re.IGNORECASE)
THOUGHT_PREFIX_RE = re.compile(r"^\s*(?:!\[)?(?:[^\x00-\x7F]+)?thought\b", re.IGNORECASE)
THOUGHT_LEAK_MARKER_RE = re.compile(r"(?:!\[thought\b|<think(?:ing)?\b|(?:[^\x00-\x7F]+)?thought\b)", re.IGNORECASE)
CRITICAL_INSTRUCTION_RE = re.compile(r"critical\s+instruction", re.IGNORECASE)
ARTIFACT_ONLY_RE = re.compile(r"^(?:_model|json|\{\})$", re.IGNORECASE)
TOOL_PAYLOAD_KEYS = {
    "command",
    "description",
    "recipient_name",
    "parameters",
    "tool_uses",
    "patchText",
    "threadID",
    "workdir",
    "follow",
}

CALENDAR_COMMAND_PERIODS: dict[str, str] = {
    "/calendar_today": "morning",
    "/calendar_morning": "morning",
    "/calendar_tomorrow": "night",
    "/calendar_night": "night",
}

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S%z",
)
log = logging.getLogger("telegram-bridge")


# ---------------------------------------------------------------------------
# Globals
# ---------------------------------------------------------------------------

shutdown_requested = False


@contextlib.contextmanager
def maybe_prefer_ipv4(enabled: bool):
    if not enabled:
        yield
        return

    original_getaddrinfo = socket.getaddrinfo

    def ipv4_first_getaddrinfo(host, port, family=0, type=0, proto=0, flags=0):
        entries = list(original_getaddrinfo(host, port, family, type, proto, flags))
        entries.sort(key=lambda item: 0 if item[0] == socket.AF_INET else 1)
        return entries

    socket.getaddrinfo = ipv4_first_getaddrinfo
    try:
        yield
    finally:
        socket.getaddrinfo = original_getaddrinfo


def handle_signal(signum, _frame):
    global shutdown_requested
    name = signal.Signals(signum).name
    log.info("Received %s, shutting down", name)
    shutdown_requested = True


signal.signal(signal.SIGTERM, handle_signal)
signal.signal(signal.SIGINT, handle_signal)


# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------


def load_state(path: Path) -> dict:
    if not path.exists():
        return {"offset": 0, "sessions": {}}

    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        log.warning("State file is invalid JSON, resetting: %s", path)
        return {"offset": 0, "sessions": {}}

    offset = raw.get("offset", 0)
    sessions = raw.get("sessions", {})
    if not isinstance(offset, int):
        offset = 0
    if not isinstance(sessions, dict):
        sessions = {}

    return {"offset": offset, "sessions": sessions}


def save_state(path: Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(state, ensure_ascii=True, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------


def request_json(url: str, payload: dict | None, timeout: int, headers: dict | None = None) -> dict:
    req_headers = {"Accept": "application/json"}
    if headers:
        req_headers.update(headers)

    data = None
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        req_headers["Content-Type"] = "application/json"

    req = urllib.request.Request(
        url,
        data=data,
        headers=req_headers,
        method="POST" if data is not None else "GET",
    )

    parsed = urllib.parse.urlparse(url)
    prefer_ipv4 = DEFAULT_PREFER_IPV4 and parsed.hostname == "api.telegram.org"

    try:
        with maybe_prefer_ipv4(prefer_ipv4):
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                body = resp.read().decode("utf-8")
    except urllib.error.HTTPError as err:
        body = err.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {err.code} {url}: {body.strip()}") from err
    except urllib.error.URLError as err:
        raise RuntimeError(f"Request failed for {url}: {err}") from err

    if not body:
        return {}

    try:
        parsed = json.loads(body)
    except json.JSONDecodeError as err:
        raise RuntimeError(f"Invalid JSON response from {url}: {body[:200]}") from err

    if not isinstance(parsed, dict):
        raise RuntimeError(f"Unexpected JSON payload from {url}: expected object")

    return parsed


def telegram_api(token: str, method: str, payload: dict | None, timeout: int) -> dict | list:
    url = f"https://api.telegram.org/bot{token}/{method}"
    data = request_json(url, payload, timeout)
    if not data.get("ok"):
        description = data.get("description", "Unknown Telegram API error")
        raise RuntimeError(f"Telegram API {method} failed: {description}")
    return data.get("result", {})


def zee_request(base_url: str, path: str, payload: dict, timeout: int, auth_token: str | None) -> dict:
    headers = {}
    if auth_token:
        headers["Authorization"] = f"Bearer {auth_token}"
    return request_json(f"{base_url}{path}", payload, timeout, headers=headers)


def zee_get(base_url: str, path: str, timeout: int, auth_token: str | None) -> dict:
    headers = {}
    if auth_token:
        headers["Authorization"] = f"Bearer {auth_token}"
    return request_json(f"{base_url}{path}", None, timeout, headers=headers)


# ---------------------------------------------------------------------------
# Telegram bridge
# ---------------------------------------------------------------------------


def parse_allowed_chat_ids(raw: str) -> set[int] | None:
    if not raw.strip():
        return None

    allowed: set[int] = set()
    for item in raw.split(","):
        value = item.strip()
        if not value:
            continue
        try:
            allowed.add(int(value))
        except ValueError:
            log.warning("Ignoring invalid chat id in allowlist: %s", value)

    return allowed if allowed else None


def chat_display_name(chat: dict) -> str:
    chat_id = str(chat.get("id", "unknown"))
    chat_type = str(chat.get("type", "private"))
    if chat_type in ("group", "supergroup", "channel"):
        title = str(chat.get("title", "")).strip()
        return title or f"{chat_type}:{chat_id}"

    first_name = str(chat.get("first_name", "")).strip()
    last_name = str(chat.get("last_name", "")).strip()
    username = str(chat.get("username", "")).strip()
    full = " ".join(x for x in (first_name, last_name) if x).strip()
    if full:
        return full
    if username:
        return f"@{username}"
    return chat_id


def command_name(text: str) -> str:
    token = text.strip().split(" ", 1)[0]
    if not token.startswith("/"):
        return ""
    # /start@MyBot -> /start
    return token.split("@", 1)[0].lower()


def command_args(text: str) -> list[str]:
    parts = text.strip().split()
    if len(parts) <= 1:
        return []
    return parts[1:]


def parse_calendar_request(text: str) -> dict | None:
    cmd = command_name(text)
    if cmd in CALENDAR_COMMAND_PERIODS:
        flags = {value.strip().lower() for value in command_args(text)}
        tu_only = bool({"--tu-only", "tu-only", "--tu", "tu"} & flags)
        return {"period": CALENDAR_COMMAND_PERIODS[cmd], "tu_only": tu_only, "mode": "command", "command": cmd}

    if cmd:
        return None

    normalized = re.sub(r"\s+", " ", text.strip().lower())
    if not re.search(r"\b(calendar|schedule|agenda)\b", normalized):
        return None

    if re.search(r"\b(tomorrow|night|tonight)\b", normalized):
        period = "night"
    elif re.search(r"\b(today|morning|now)\b", normalized):
        period = "morning"
    else:
        return None

    tu_only = bool(re.search(r"\b(tuwel|tu|technische universitaet|technische universität)\b", normalized))
    return {"period": period, "tu_only": tu_only, "mode": "natural"}


def run_calendar_overview(period: str, tu_only: bool) -> str:
    if period not in {"morning", "night"}:
        raise RuntimeError(f"Unsupported calendar period: {period}")
    if DEFAULT_CALENDAR_TIMEOUT < 10:
        raise RuntimeError("ZEE_TELEGRAM_CALENDAR_TIMEOUT must be >= 10")

    command = [
        DEFAULT_CALENDAR_PYTHON,
        DEFAULT_CALENDAR_SCRIPT,
        "--period",
        period,
        "--print-only",
        "--include-tuwel",
    ]
    if tu_only:
        command.append("--tu-only")

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        timeout=DEFAULT_CALENDAR_TIMEOUT,
    )
    if result.returncode != 0:
        stderr = result.stderr.strip()
        stdout = result.stdout.strip()
        detail = stderr or stdout or f"exit code {result.returncode}"
        raise RuntimeError(f"calendar overview failed: {detail}")

    output = result.stdout.strip()
    if not output:
        raise RuntimeError("calendar overview returned no text")
    return output


def chunk_text(text: str, max_len: int = TELEGRAM_MAX_TEXT) -> list[str]:
    if len(text) <= max_len:
        return [text]

    chunks: list[str] = []
    remaining = text
    while len(remaining) > max_len:
        idx = remaining.rfind("\n", 0, max_len + 1)
        if idx == -1 or idx < (max_len // 2):
            idx = max_len
        chunk = remaining[:idx].rstrip()
        if not chunk:
            chunk = remaining[:max_len]
            idx = len(chunk)
        chunks.append(chunk)
        remaining = remaining[idx:].lstrip("\n")

    if remaining:
        chunks.append(remaining)

    return chunks


def sanitize_assistant_text(text: str) -> str:
    cleaned = text.strip()
    if not cleaned:
        return ""

    cleaned = THOUGHT_BLOCK_RE.sub("", cleaned)
    cleaned = THINK_TAG_RE.sub("", cleaned)
    cleaned = cleaned.strip()

    thought_start = re.search(r"!\[thought\b", cleaned, flags=re.IGNORECASE)
    if thought_start is not None:
        cleaned = cleaned[:thought_start.start()].rstrip()

    think_start = re.search(r"<think(?:ing)?\b", cleaned, flags=re.IGNORECASE)
    if think_start is not None:
        trailing = cleaned[think_start.start():]
        if re.search(r"</think(?:ing)?>", trailing, flags=re.IGNORECASE) is None:
            cleaned = cleaned[:think_start.start()].rstrip()

    if not cleaned:
        return ""

    if contains_critical_instruction_thought_leak(cleaned):
        return ""

    # Defensive guard for providers that occasionally surface thought content
    # as plain text instead of a structured reasoning part.
    if THOUGHT_PREFIX_RE.match(cleaned):
        return ""
    if ARTIFACT_ONLY_RE.match(cleaned):
        return ""
    if is_likely_dangling_json_artifact(cleaned):
        return ""
    if is_likely_tool_call_payload(cleaned):
        return ""
    if is_effectively_empty_json_artifact(cleaned):
        return ""

    return cleaned


def contains_critical_instruction_thought_leak(text: str) -> bool:
    return bool(CRITICAL_INSTRUCTION_RE.search(text) and THOUGHT_LEAK_MARKER_RE.search(text))


def classify_bridge_error(err: Exception | str) -> str:
    message = str(err).strip().lower()
    if not message:
        return "unknown"
    if (
        "connection refused" in message
        or "errno 111" in message
        or "request failed for http://127.0.0.1:3210" in message
    ):
        return "daemon_unreachable"
    if "ai_retryerror" in message or "high demand" in message or "rate limit" in message:
        return "model_capacity"
    if "stream timeout" in message or "no response received for 300s" in message:
        return "upstream_timeout"
    if "timed out" in message or "timeout" in message:
        return "upstream_timeout"
    return "unknown"


def format_bridge_error_for_user(err: Exception | str, bucket: str) -> str:
    if bucket == "daemon_unreachable":
        return "Zee bridge error: daemon unreachable (local API is offline)."
    if bucket == "model_capacity":
        return "Zee bridge error: model is under high demand. Please retry."
    if bucket == "upstream_timeout":
        return "Zee bridge error: upstream timeout waiting for model response."
    return f"Zee bridge error: {err}"

def is_likely_dangling_json_artifact(text: str) -> bool:
    stripped = strip_code_fence(text.strip())
    if re.match(r"^json\b", stripped, flags=re.IGNORECASE) is None:
        return False
    payload = re.sub(r"^json\b[:\s]*", "", stripped, flags=re.IGNORECASE).strip()
    if not payload:
        return True
    return re.match(r"^[{[]\s*$", payload) is not None

def is_likely_tool_call_payload(text: str) -> bool:
    parsed = parse_loose_json_object(text)
    if not isinstance(parsed, dict):
        return False
    return any(key in TOOL_PAYLOAD_KEYS for key in parsed.keys())


def is_effectively_empty_json_artifact(text: str) -> bool:
    parsed = parse_loose_json_object(text)
    if not isinstance(parsed, dict):
        return False
    keys = list(parsed.keys())
    if len(keys) == 0:
        return True
    if "content" not in parsed:
        return False
    return all(is_empty_json_value(parsed.get(key)) for key in keys)


def parse_loose_json_object(text: str) -> dict | None:
    stripped = strip_code_fence(text.strip())
    stripped_prefix = re.sub(r"^json\b[:\s]*", "", stripped, flags=re.IGNORECASE).strip()
    candidate = stripped_prefix if stripped_prefix.startswith("{") else stripped
    if not (candidate.startswith("{") and candidate.endswith("}")):
        return None
    try:
        parsed = json.loads(candidate)
    except Exception:
        return None
    return parsed if isinstance(parsed, dict) else None


def strip_code_fence(text: str) -> str:
    match = re.match(r"^```(?:json)?\s*([\s\S]*?)\s*```$", text, flags=re.IGNORECASE)
    if match:
        return match.group(1).strip()
    return text


def is_empty_json_value(value: object) -> bool:
    if value is None:
        return True
    if isinstance(value, str):
        return len(value.strip()) == 0
    if isinstance(value, list):
        return len(value) == 0 or all(is_empty_json_value(v) for v in value)
    if isinstance(value, dict):
        return len(value) == 0 or all(is_empty_json_value(v) for v in value.values())
    return False


def telegram_send_text(
    token: str,
    chat_id: int,
    text: str,
    reply_to_message_id: int | None = None,
    *,
    max_chunks: int = DEFAULT_MAX_REPLY_CHUNKS,
    max_chars: int = DEFAULT_MAX_REPLY_CHARS,
) -> None:
    if max_chars > 0 and len(text) > max_chars:
        text = text[:max_chars].rstrip() + f"\n\n[Response truncated to {max_chars} characters.]"
    chunks = chunk_text(text)
    if max_chunks > 0 and len(chunks) > max_chunks:
        chunks = chunks[:max_chunks]
        suffix = "\n\n[Response truncated: too many chunks.]"
        chunks[-1] = (chunks[-1] + suffix)[:TELEGRAM_MAX_TEXT]
    for i, chunk in enumerate(chunks):
        payload = {
            "chat_id": chat_id,
            "text": chunk,
            "allow_sending_without_reply": True,
        }
        if reply_to_message_id is not None and i == 0:
            payload["reply_to_message_id"] = reply_to_message_id
        telegram_api(token, "sendMessage", payload, timeout=20)


def telegram_send_typing(token: str, chat_id: int) -> None:
    try:
        telegram_api(
            token,
            "sendChatAction",
            {"chat_id": chat_id, "action": "typing"},
            timeout=10,
        )
    except Exception as err:
        log.debug("typing indicator failed: %s", err)


def ensure_session(
    state: dict,
    chat: dict,
    base_url: str,
    agent: str,
    session_surface: str,
    session_mode: str,
    auth_token: str | None,
) -> str:
    chat_id = str(chat.get("id"))
    existing = state["sessions"].get(chat_id)
    if isinstance(existing, str) and existing:
        try:
            session = zee_get(
                base_url,
                f"/session/{existing}",
                timeout=20,
                auth_token=auth_token,
            )
            existing_surface = session.get("surface")
            if isinstance(existing_surface, str) and existing_surface and existing_surface != session_surface:
                log.info(
                    "Replacing session %s for chat %s due to surface mismatch (%s != %s)",
                    existing,
                    chat_id,
                    existing_surface,
                    session_surface,
                )
                state["sessions"].pop(chat_id, None)
            else:
                return existing
        except Exception as err:
            log.warning("Session %s for chat %s is invalid, creating a new one: %s", existing, chat_id, err)
            state["sessions"].pop(chat_id, None)

    title = f"Telegram: {chat_display_name(chat)} ({chat_id})"
    payload = {"title": title, "surface": session_surface}
    if session_mode:
        payload["mode"] = session_mode
    created = zee_request(
        base_url,
        "/session",
        payload,
        timeout=30,
        auth_token=auth_token,
    )
    session_id = created.get("id")
    if not isinstance(session_id, str) or not session_id:
        raise RuntimeError(f"Invalid session.create response: {created}")

    state["sessions"][chat_id] = session_id
    log.info("Created session %s for chat %s via agent=%s", session_id, chat_id, agent)
    return session_id


def prompt_zee(
    base_url: str,
    session_id: str,
    text: str,
    sender_id: str,
    agent: str,
    model_provider: str | None,
    model_id: str | None,
    auth_token: str | None,
    message_timeout: int,
) -> str:
    payload = {
        "agent": agent,
        "parts": [{"type": "text", "text": text}],
        "options": {"senderId": sender_id},
    }
    if model_provider and model_id:
        payload["model"] = {"providerID": model_provider, "modelID": model_id}
    response = zee_request(
        base_url,
        f"/session/{session_id}/message",
        payload,
        timeout=message_timeout,
        auth_token=auth_token,
    )

    parts = response.get("parts", [])
    texts: list[str] = []
    if isinstance(parts, list):
        for part in parts:
            if not isinstance(part, dict):
                continue
            if part.get("type") != "text":
                continue
            if part.get("synthetic") is True or part.get("ignored") is True:
                continue
            value = part.get("text")
            if isinstance(value, str) and value.strip():
                cleaned = sanitize_assistant_text(value)
                if cleaned:
                    texts.append(cleaned)

    combined = "\n".join(texts).strip()
    if combined:
        return combined

    info = response.get("info")
    if isinstance(info, dict):
        error = info.get("error")
        if isinstance(error, dict):
            # NamedError payloads usually look like:
            # { name: "...", data: { message: "...", ... } }
            message = error.get("message")
            if isinstance(message, str) and message.strip():
                return f"Zee error: {message.strip()}"

            data = error.get("data")
            if isinstance(data, dict):
                data_message = data.get("message")
                if isinstance(data_message, str) and data_message.strip():
                    return f"Zee error: {data_message.strip()}"

    return "No text response returned."


def handle_update(
    update: dict,
    *,
    token: str,
    base_url: str,
    state: dict,
    agent: str,
    session_surface: str,
    session_mode: str,
    model_provider: str | None,
    model_id: str | None,
    allowed_chat_ids: set[int] | None,
    auth_token: str | None,
    max_reply_chunks: int,
    max_reply_chars: int,
    message_timeout: int,
) -> bool:
    message = update.get("message")
    if not isinstance(message, dict):
        return False

    chat = message.get("chat")
    if not isinstance(chat, dict):
        return False

    chat_id = chat.get("id")
    if not isinstance(chat_id, int):
        return False

    if allowed_chat_ids is not None and chat_id not in allowed_chat_ids:
        log.info("Ignoring message from disallowed chat %s", chat_id)
        return False

    text = message.get("text")
    if not isinstance(text, str):
        caption = message.get("caption")
        text = caption if isinstance(caption, str) else ""

    text = text.strip()
    if not text:
        return False

    cmd = command_name(text)
    if cmd in {"/start", "/help"}:
        telegram_send_text(
            token,
            chat_id,
            "Zee Telegram bridge is online.\n\n"
            "Commands:\n"
            "/new - start a fresh Zee session\n"
            "/session - show current session id\n"
            "/calendar_today - show today's combined digest\n"
            "/calendar_tomorrow - show tomorrow's combined digest\n"
            "/calendar_today --tu-only - TUWEL only\n"
            "/help - show this message",
            reply_to_message_id=message.get("message_id"),
            max_chunks=max_reply_chunks,
            max_chars=max_reply_chars,
        )
        return False

    calendar_request = parse_calendar_request(text)
    if calendar_request is not None:
        telegram_send_typing(token, chat_id)
        digest = run_calendar_overview(calendar_request["period"], calendar_request["tu_only"])
        telegram_send_text(
            token,
            chat_id,
            digest,
            reply_to_message_id=message.get("message_id"),
            max_chunks=max_reply_chunks,
            max_chars=max_reply_chars,
        )
        return False

    if cmd in {"/new", "/reset"}:
        key = str(chat_id)
        previous = state["sessions"].pop(key, None)
        telegram_send_text(
            token,
            chat_id,
            f"Started a new Zee session for this chat."
            + (f"\nPrevious session: {previous}" if isinstance(previous, str) else ""),
            reply_to_message_id=message.get("message_id"),
            max_chunks=max_reply_chunks,
            max_chars=max_reply_chars,
        )
        return True

    if cmd == "/session":
        session_id = ensure_session(
            state,
            chat,
            base_url,
            agent,
            session_surface,
            session_mode,
            auth_token,
        )
        telegram_send_text(
            token,
            chat_id,
            f"Current Zee session: {session_id}",
            reply_to_message_id=message.get("message_id"),
            max_chunks=max_reply_chunks,
            max_chars=max_reply_chars,
        )
        return True

    sender_id = str(chat_id)
    session_id = ensure_session(
        state,
        chat,
        base_url,
        agent,
        session_surface,
        session_mode,
        auth_token,
    )
    telegram_send_typing(token, chat_id)
    reply = prompt_zee(
        base_url,
        session_id,
        text,
        sender_id,
        agent,
        model_provider,
        model_id,
        auth_token,
        message_timeout,
    )
    telegram_send_text(
        token,
        chat_id,
        reply,
        reply_to_message_id=message.get("message_id"),
        max_chunks=max_reply_chunks,
        max_chars=max_reply_chars,
    )
    return True


def run(
    token: str,
    base_url: str,
    state_path: Path,
    poll_timeout: int,
    agent: str,
    session_surface: str,
    session_mode: str,
    model_provider: str | None,
    model_id: str | None,
    allowed_chat_ids: set[int] | None,
    auth_token: str | None,
    max_reply_chunks: int,
    max_reply_chars: int,
    message_timeout: int,
) -> None:
    state = load_state(state_path)
    save_state(state_path, state)

    log.info(
        "Telegram bridge running (base_url=%s, agent=%s, surface=%s, mode=%s, model=%s/%s, poll_timeout=%ss, msg_timeout=%ss, allowed_chats=%s, calendar_script=%s)",
        base_url,
        agent,
        session_surface,
        session_mode,
        model_provider or "-",
        model_id or "-",
        poll_timeout,
        message_timeout,
        "*" if allowed_chat_ids is None else len(allowed_chat_ids),
        DEFAULT_CALENDAR_SCRIPT,
    )

    consecutive_errors = 0

    while not shutdown_requested:
        dirty = False
        try:
            updates = telegram_api(
                token,
                "getUpdates",
                {
                    "offset": state.get("offset", 0),
                    "timeout": poll_timeout,
                    "allowed_updates": ["message"],
                },
                timeout=poll_timeout + 15,
            )

            if not isinstance(updates, list):
                raise RuntimeError("Telegram getUpdates returned non-list payload")

            for update in updates:
                if not isinstance(update, dict):
                    continue

                update_id = update.get("update_id")
                if isinstance(update_id, int):
                    next_offset = update_id + 1
                    if next_offset > state.get("offset", 0):
                        state["offset"] = next_offset
                        dirty = True

                try:
                    changed = handle_update(
                        update,
                        token=token,
                        base_url=base_url,
                        state=state,
                        agent=agent,
                        session_surface=session_surface,
                        session_mode=session_mode,
                        model_provider=model_provider,
                        model_id=model_id,
                        allowed_chat_ids=allowed_chat_ids,
                        auth_token=auth_token,
                        max_reply_chunks=max_reply_chunks,
                        max_reply_chars=max_reply_chars,
                        message_timeout=message_timeout,
                    )
                    dirty = dirty or changed
                    consecutive_errors = 0
                except Exception as err:
                    consecutive_errors += 1
                    bucket = classify_bridge_error(err)
                    log.warning(
                        "Failed to process update (bucket=%s, update_id=%s): %s",
                        bucket,
                        update.get("update_id"),
                        err,
                    )

                    # Best effort error response if we can identify the chat
                    msg = update.get("message")
                    chat = msg.get("chat") if isinstance(msg, dict) else None
                    chat_id = chat.get("id") if isinstance(chat, dict) else None
                    if isinstance(chat_id, int):
                        try:
                            telegram_send_text(
                                token,
                                chat_id,
                                format_bridge_error_for_user(err, bucket),
                                reply_to_message_id=msg.get("message_id") if isinstance(msg, dict) else None,
                                max_chunks=max_reply_chunks,
                                max_chars=max_reply_chars,
                            )
                        except Exception:
                            pass

            if dirty:
                save_state(state_path, state)

        except Exception as err:
            consecutive_errors += 1
            bucket = classify_bridge_error(err)
            log.warning("Polling loop error (%d, bucket=%s): %s", consecutive_errors, bucket, err)
            if dirty:
                save_state(state_path, state)

            # Backoff on repeated failure
            sleep_s = min(30, 1 + consecutive_errors)
            slept = 0.0
            while slept < sleep_s and not shutdown_requested:
                time.sleep(min(0.5, sleep_s - slept))
                slept += 0.5

    save_state(state_path, state)
    log.info("Bridge stopped")


def main():
    parser = argparse.ArgumentParser(description="Telegram long-poll bridge for Zee daemon.")
    parser.add_argument("--token", default=os.environ.get("TELEGRAM_BOT_TOKEN", "").strip(), help="Telegram bot token")
    parser.add_argument("--zee-api-url", default=DEFAULT_ZEE_API_URL, help=f"Zee API base URL (default: {DEFAULT_ZEE_API_URL})")
    parser.add_argument("--agent", default=DEFAULT_AGENT, help=f"Agent to use for prompts (default: {DEFAULT_AGENT})")
    parser.add_argument(
        "--model-provider",
        default=DEFAULT_MODEL_PROVIDER,
        help="Optional model provider override (for session prompt model.providerID)",
    )
    parser.add_argument(
        "--model-id",
        default=DEFAULT_MODEL_ID,
        help="Optional model id override (for session prompt model.modelID)",
    )
    parser.add_argument(
        "--session-surface",
        default=DEFAULT_SESSION_SURFACE,
        choices=["api", "whatsapp", "telegram"],
        help=f"Session surface value (default: {DEFAULT_SESSION_SURFACE})",
    )
    parser.add_argument(
        "--session-mode",
        default=DEFAULT_SESSION_MODE,
        choices=["plan", "accept", "bypass"],
        help=f"Session mode value (default: {DEFAULT_SESSION_MODE})",
    )
    parser.add_argument(
        "--state-path",
        default=DEFAULT_STATE_PATH,
        help=f"State file path (default: {DEFAULT_STATE_PATH})",
    )
    parser.add_argument(
        "--poll-timeout",
        type=int,
        default=DEFAULT_POLL_TIMEOUT,
        help=f"Telegram long-poll timeout in seconds (default: {DEFAULT_POLL_TIMEOUT})",
    )
    parser.add_argument(
        "--allowed-chat-ids",
        default=DEFAULT_ALLOWED_CHAT_IDS,
        help="Optional CSV allowlist of numeric Telegram chat IDs",
    )
    parser.add_argument(
        "--zee-api-token",
        default=DEFAULT_ZEE_API_TOKEN,
        help="Optional Bearer token for Zee API auth",
    )
    parser.add_argument(
        "--max-reply-chunks",
        type=int,
        default=DEFAULT_MAX_REPLY_CHUNKS,
        help=f"Maximum Telegram chunks per reply (default: {DEFAULT_MAX_REPLY_CHUNKS})",
    )
    parser.add_argument(
        "--max-reply-chars",
        type=int,
        default=DEFAULT_MAX_REPLY_CHARS,
        help=f"Maximum characters per reply before truncation (default: {DEFAULT_MAX_REPLY_CHARS})",
    )
    parser.add_argument(
        "--message-timeout",
        type=int,
        default=DEFAULT_MESSAGE_TIMEOUT,
        help=f"Timeout in seconds for Zee /message calls (default: {DEFAULT_MESSAGE_TIMEOUT})",
    )
    args = parser.parse_args()

    token = args.token.strip()
    if not token:
        raise SystemExit("Missing Telegram token. Set TELEGRAM_BOT_TOKEN or pass --token.")

    if args.poll_timeout < 1:
        raise SystemExit("--poll-timeout must be >= 1")
    if args.max_reply_chunks < 1:
        raise SystemExit("--max-reply-chunks must be >= 1")
    if args.max_reply_chars < 1:
        raise SystemExit("--max-reply-chars must be >= 1")
    if args.message_timeout < 10:
        raise SystemExit("--message-timeout must be >= 10")

    model_provider = args.model_provider.strip() or None
    model_id = args.model_id.strip() or None
    if bool(model_provider) ^ bool(model_id):
        raise SystemExit("Set both --model-provider and --model-id together (or leave both empty).")

    allowed_chat_ids = parse_allowed_chat_ids(args.allowed_chat_ids)
    run(
        token=token,
        base_url=args.zee_api_url.rstrip("/"),
        state_path=Path(args.state_path).expanduser(),
        poll_timeout=args.poll_timeout,
        agent=args.agent,
        session_surface=args.session_surface,
        session_mode=args.session_mode,
        model_provider=model_provider,
        model_id=model_id,
        allowed_chat_ids=allowed_chat_ids,
        auth_token=args.zee_api_token.strip() or None,
        max_reply_chunks=args.max_reply_chunks,
        max_reply_chars=args.max_reply_chars,
        message_timeout=args.message_timeout,
    )


if __name__ == "__main__":
    main()
