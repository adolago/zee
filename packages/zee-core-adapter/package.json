{
  "name": "@zee/core-adapter",
  "version": "0.1.0",
  "description": "Adapter layer between OpenCode Web UI and Zee",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "import": "./src/theme/tui-theme.css"
    },
    "./theme.css": "./src/theme/tui-theme.css"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser",
    "dev": "bun build ./src/index.ts --outdir ./dist --target browser --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "1.3.8",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "solid-js": "1.9.10"
  }
}
