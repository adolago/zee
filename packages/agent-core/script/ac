#!/bin/bash
# ac - agent-core master command (user systemd service manager)
#
# Usage: ac [command] [args...]
# Commands:
#   dev (default)     Run legacy ac-dev script (nuke + self-test), then open TUI
#   up                Pristine start: build + tests + self-test, then enable+start service (no TUI)
#   start             Enable service and start it, then open TUI (fast path)
#   stop              Stop the user service
#   restart           Restart the user service
#   status            Show user service status
#   logs [args...]    Tail user service logs (passes args to journalctl)
#   enable            Enable user service + linger (start at boot)
#   disable           Disable user service (and stop it)
#   tui [args...]     Open the agent-core TUI (uses running service)
#   dev [args...]     Run legacy ac-dev script (nuke + self-test)
#   help              Show this help
#
# Symlink: ln -sf ~/.local/src/agent-core/packages/agent-core/script/ac ~/bin/ac

set -euo pipefail

SERVICE="agent-core"
USER_SYSTEMCTL=(systemctl --user)
LOG_PREFIX="[ac]"

usage() {
  cat <<'USAGE'
ac - agent-core master command (user systemd service manager)

Usage: ac [command] [args...]

Commands:
  dev (default)     Run legacy ac-dev script (nuke + self-test), then open TUI
  up                Pristine start: build + tests + self-test, then enable+start service (no TUI)
  start             Enable service and start it, then open TUI (fast path)
  stop              Stop the user service
  restart           Restart the user service
  status            Show user service status
  logs [args...]    Tail user service logs (passes args to journalctl)
  enable            Enable user service + linger (start at boot)
  disable           Disable user service (and stop it)
  tui [args...]     Open the agent-core TUI (uses running service)
  dev [args...]     Run legacy ac-dev script (nuke + self-test)
  help              Show this help

Examples:
  ac
  ac up
  ac start
  ac status
  ac logs
  ac tui
USAGE
}

require_systemctl() {
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "$LOG_PREFIX systemctl not found; cannot manage services" >&2
    exit 1
  fi
}

service_exists() {
  "${USER_SYSTEMCTL[@]}" list-unit-files --type=service 2>/dev/null | awk '{print $1}' | grep -qx "${SERVICE}.service"
}

warn_if_system_service_active() {
  if command -v systemctl >/dev/null 2>&1; then
    if systemctl list-unit-files --type=service 2>/dev/null | awk '{print $1}' | grep -qx "${SERVICE}.service"; then
      local state
      state=$(systemctl is-active "${SERVICE}" 2>/dev/null || true)
      if [[ "$state" == "active" || "$state" == "activating" ]]; then
        echo "$LOG_PREFIX warning: system-level ${SERVICE}.service is active; this command manages the user service" >&2
      fi
    fi
  fi
}

ensure_service() {
  if ! service_exists; then
    echo "$LOG_PREFIX ${SERVICE}.service not found for user" >&2
    echo "$LOG_PREFIX expected unit at ~/.config/systemd/user/${SERVICE}.service" >&2
    echo "$LOG_PREFIX if you installed via packages, rerun the installer or setup scripts" >&2
    exit 1
  fi
}

linger_status() {
  if ! command -v loginctl >/dev/null 2>&1; then
    echo "unknown"
    return 0
  fi
  local value
  value=$(loginctl show-user "$USER" -p Linger 2>/dev/null | cut -d= -f2 || true)
  if [[ -z "$value" ]]; then
    echo "unknown"
  else
    echo "$value"
  fi
}

enable_linger() {
  if ! command -v loginctl >/dev/null 2>&1; then
    echo "$LOG_PREFIX loginctl not found; cannot enable linger automatically" >&2
    return 1
  fi
  if loginctl enable-linger "$USER" >/dev/null 2>&1; then
    return 0
  fi
  echo "$LOG_PREFIX failed to enable linger; try: sudo loginctl enable-linger $USER" >&2
  return 1
}

cmd_start() {
  require_systemctl
  warn_if_system_service_active
  ensure_service
  echo "$LOG_PREFIX starting ${SERVICE} (fast path)" >&2
  "${USER_SYSTEMCTL[@]}" enable --now "$SERVICE" >/dev/null
  local linger
  linger=$(linger_status)
  if [[ "$linger" != "yes" ]]; then
    enable_linger || true
    linger=$(linger_status)
    if [[ "$linger" != "yes" ]]; then
      echo "$LOG_PREFIX note: linger is $linger; enable with: ac enable" >&2
    fi
  fi
  "${USER_SYSTEMCTL[@]}" is-active "$SERVICE" >/dev/null
  echo "$LOG_PREFIX ${SERVICE} is running" >&2
  echo "$LOG_PREFIX launching TUI (use: ac dev for full self-test)" >&2
  cmd_tui
}

cmd_stop() {
  require_systemctl
  ensure_service
  "${USER_SYSTEMCTL[@]}" stop "$SERVICE" >/dev/null || true
  echo "$LOG_PREFIX ${SERVICE} stopped"
}

cmd_restart() {
  require_systemctl
  warn_if_system_service_active
  ensure_service
  "${USER_SYSTEMCTL[@]}" restart "$SERVICE"
  echo "$LOG_PREFIX ${SERVICE} restarted"
}

cmd_status() {
  require_systemctl
  ensure_service
  "${USER_SYSTEMCTL[@]}" status "$SERVICE" --no-pager
}

cmd_logs() {
  require_systemctl
  ensure_service
  journalctl --user -u "$SERVICE" -f "$@"
}

cmd_enable() {
  require_systemctl
  warn_if_system_service_active
  ensure_service
  "${USER_SYSTEMCTL[@]}" enable --now "$SERVICE"
  local linger
  linger=$(linger_status)
  if [[ "$linger" != "yes" ]]; then
    enable_linger || true
  fi
  echo "$LOG_PREFIX ${SERVICE} enabled (start at boot when linger is on)"
}

cmd_disable() {
  require_systemctl
  ensure_service
  "${USER_SYSTEMCTL[@]}" disable --now "$SERVICE" || "${USER_SYSTEMCTL[@]}" disable "$SERVICE"
  echo "$LOG_PREFIX ${SERVICE} disabled"
}

cmd_tui() {
  if ! command -v agent-core >/dev/null 2>&1; then
    echo "$LOG_PREFIX agent-core not found on PATH" >&2
    exit 1
  fi
  exec agent-core "$@"
}

cmd_dev() {
  local script_path
  if command -v realpath >/dev/null 2>&1; then
    script_path="$(realpath "${BASH_SOURCE[0]}")"
  else
    script_path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  fi
  local script_dir
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  local legacy="$script_dir/ac-dev"
  if [[ ! -x "$legacy" ]]; then
    echo "$LOG_PREFIX legacy script not found: $legacy" >&2
    exit 1
  fi
  exec "$legacy" "$@"
}

cmd_up() {
  require_systemctl
  warn_if_system_service_active
  ensure_service

  # Run the full rebuild + tests + self-test flow, but don't open the TUI.
  local script_path
  if command -v realpath >/dev/null 2>&1; then
    script_path="$(realpath "${BASH_SOURCE[0]}")"
  else
    script_path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  fi
  local script_dir
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  local legacy="$script_dir/ac-dev"
  if [[ ! -x "$legacy" ]]; then
    echo "$LOG_PREFIX legacy script not found: $legacy" >&2
    exit 1
  fi

  "$legacy" --no-tui "$@"

  # "Turn on and forget": ensure enabled for boot, and try to enable linger.
  cmd_enable
}

main() {
  local cmd="${1:-dev}"
  shift || true
  case "$cmd" in
    up ) cmd_up "$@" ;;
    start ) cmd_start "$@" ;;
    stop ) cmd_stop "$@" ;;
    restart ) cmd_restart "$@" ;;
    status ) cmd_status "$@" ;;
    logs ) cmd_logs "$@" ;;
    enable ) cmd_enable "$@" ;;
    disable ) cmd_disable "$@" ;;
    tui ) cmd_tui "$@" ;;
    dev|"" ) cmd_dev "$@" ;;
    help|-h|--help ) usage ;;
    * )
      echo "$LOG_PREFIX unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
