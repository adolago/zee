#!/bin/bash
# ac - Nuke and boot: kills all agent-core processes, then runs the LOCAL dev binary
#
# Usage: ac [args...]
#
# Symlink: ln -sf ~/.local/src/agent-core/packages/agent-core/script/ac ~/bin/ac
#
# Use `agent-core` for normal boot (no nuke), `ac` for fresh start.

set -e

# Resolve the real script location (following symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Detect platform
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)  PLATFORM="linux-x64" ;;
    Linux-aarch64) PLATFORM="linux-arm64" ;;
    Darwin-x86_64) PLATFORM="darwin-x64" ;;
    Darwin-arm64)  PLATFORM="darwin-arm64" ;;
    *)             echo "Unsupported platform: $(uname -s)-$(uname -m)"; exit 1 ;;
esac

LOCAL_BINARY="$REPO_ROOT/dist/@agent-core/core-$PLATFORM/bin/agent-core"

# Check if binary exists
if [[ ! -f "$LOCAL_BINARY" ]]; then
    echo "Binary not found: $LOCAL_BINARY"
    echo "Run: cd packages/agent-core && bun run build"
    exit 1
fi

# Check if source is newer than binary - auto-rebuild if needed
STALE=""
# Check source files
STALE=$(find "$REPO_ROOT/src" \( -name "*.ts" -o -name "*.tsx" \) -type f -newer "$LOCAL_BINARY" -print -quit 2>/dev/null)
# Check config files at repo root
if [[ -z "$STALE" ]]; then
    for f in "$REPO_ROOT/package.json" "$REPO_ROOT/tsconfig.json"; do
        if [[ -f "$f" && "$f" -nt "$LOCAL_BINARY" ]]; then
            STALE="$f"
            break
        fi
    done
fi

if [[ -n "$STALE" ]]; then
    echo -e "\033[1;33m[ac] Source newer than binary (${STALE#$REPO_ROOT/}) - rebuilding...\033[0m" >&2
    (cd "$REPO_ROOT" && bun run build) || { echo "[ac] Build failed"; exit 1; }
fi

# Nuke: kill all existing agent-core processes
if pgrep -f "agent-core" > /dev/null 2>&1; then
    echo -e "\033[1;36m[ac] Killing existing agent-core processes...\033[0m" >&2
    pkill -9 -f "agent-core" 2>/dev/null || true
    sleep 1
fi

# Boot: run the local binary
exec "$LOCAL_BINARY" "$@"
