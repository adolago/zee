#!/bin/bash
# ac-dev - Nuke, verify, and boot: kills all processes, runs self-test, then opens TUI
#
# Usage: ac dev [args...]
#   ac dev --skip-test    Skip the self-test (messaging + provider checks)
#   ac dev --no-build     Skip rebuild (use existing binary)
#   ac dev --no-tui       Do everything but don't open the TUI (start service and exit)
#
# This script is invoked via `ac dev`. The main `ac` command manages the
# systemd service.
#
# Use `agent-core` for normal boot (no nuke), `ac dev` for fresh start.
# The self-test starts a headless daemon, verifies providers and messaging,
# then opens the TUI only if everything passes. If anything fails, ac dev exits
# without opening the TUI -- broken software does not ship.

set -e

# Resolve the real script location (following symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MONOREPO_ROOT="$(cd "$REPO_ROOT/../.." && pwd)"

# Parse flags
SKIP_TEST=false
NO_BUILD=false
NO_TUI=false
PASSTHROUGH_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --skip-test) SKIP_TEST=true ;;
        --no-build) NO_BUILD=true ;;
        --no-tui) NO_TUI=true ;;
        *) PASSTHROUGH_ARGS+=("$arg") ;;
    esac
done

# Detect platform
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)  PLATFORM="linux-x64" ;;
    Linux-aarch64) PLATFORM="linux-arm64" ;;
    Darwin-x86_64) PLATFORM="darwin-x64" ;;
    Darwin-arm64)  PLATFORM="darwin-arm64" ;;
    *)             echo "Unsupported platform: $(uname -s)-$(uname -m)"; exit 1 ;;
esac

LOCAL_BINARY="$REPO_ROOT/dist/@agent-core/core-$PLATFORM/bin/agent-core"
DAEMON_PORT=3210

# If we temporarily mask the user systemd service (to prevent Restart=always
# respawns during self-test), we must always restore it.
AC_USER_SVC_WAS_MASKED=false
AC_USER_SVC_RUNTIME_MASKED=false

cleanup() {
    # Stop any test daemon (function is defined only in the self-test section).
    if declare -F ac_test_cleanup >/dev/null 2>&1; then
        ac_test_cleanup || true
    fi

    # Restore systemd user service mask if we applied a runtime mask.
    if [[ "$AC_USER_SVC_RUNTIME_MASKED" == "true" && "$AC_USER_SVC_WAS_MASKED" != "true" ]]; then
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user unmask agent-core >/dev/null 2>&1 || true
        fi
    fi
}
trap cleanup EXIT

# Always rebuild unless --no-build is set
if [[ "$NO_BUILD" != "true" ]]; then
    echo -e "\033[1;33m[ac] Rebuilding (forced)...\033[0m" >&2
    (cd "$REPO_ROOT" && bun run build) || { echo "[ac] Build failed"; exit 1; }
else
    # Warn if binary is stale when skipping build
    if [[ -f "$LOCAL_BINARY" ]]; then
        STALE=$(find "$REPO_ROOT/src" \( -name "*.ts" -o -name "*.tsx" \) -type f -newer "$LOCAL_BINARY" -print -quit 2>/dev/null)
        if [[ -z "$STALE" ]]; then
            for f in "$REPO_ROOT/package.json" "$REPO_ROOT/tsconfig.json"; do
                if [[ -f "$f" && "$f" -nt "$LOCAL_BINARY" ]]; then
                    STALE="$f"
                    break
                fi
            done
        fi
        if [[ -n "$STALE" ]]; then
            echo -e "\033[1;33m[ac] Warning: binary older than ${STALE#$REPO_ROOT/} (use ac dev without --no-build)\033[0m" >&2
        fi
    fi
fi

# Verify binary exists after build
if [[ ! -f "$LOCAL_BINARY" ]]; then
    echo -e "\033[1;31m[ac] Binary not found after build: $LOCAL_BINARY\033[0m" >&2
    echo "The build may have failed silently. Try: cd $REPO_ROOT && bun run build" >&2
    exit 1
fi

if [[ "$PLATFORM" == "linux-x64" ]]; then
    echo -e "\033[1;36m[ac] Verifying binary...\033[0m" >&2
    (cd "$REPO_ROOT" && ./script/verify-binary.sh) || { echo "[ac] Binary verification failed"; exit 1; }
fi

# Stop systemd service first (Restart=always would respawn killed processes).
# Always issue stop -- the service may be active, activating (RestartSec
# cooldown), or reloading.  After stop, wait until it reaches inactive so
# nothing sneaks back while we run the self-test.
if command -v systemctl >/dev/null 2>&1; then
    if systemctl list-unit-files --type=service 2>/dev/null | awk '{print $1}' | grep -qx "agent-core.service"; then
        SYS_SVC_STATE=$(systemctl is-active agent-core 2>/dev/null || true)
        if [[ "$SYS_SVC_STATE" == "active" || "$SYS_SVC_STATE" == "activating" || "$SYS_SVC_STATE" == "deactivating" ]]; then
            echo -e "\033[1;36m[ac] Stopping system agent-core service ($SYS_SVC_STATE)...\033[0m" >&2
            if ! sudo -n systemctl stop agent-core 2>/dev/null; then
                echo -e "\033[1;31m[ac] Unable to stop system agent-core service. Run: sudo systemctl stop agent-core\033[0m" >&2
                exit 1
            fi
            for _i in $(seq 1 20); do
                SYS_SVC_STATE=$(systemctl is-active agent-core 2>/dev/null || true)
                [[ "$SYS_SVC_STATE" == "inactive" || "$SYS_SVC_STATE" == "dead" || "$SYS_SVC_STATE" == "failed" ]] && break
                sleep 0.5
            done
            SYS_SVC_STATE=$(systemctl is-active agent-core 2>/dev/null || true)
            if [[ "$SYS_SVC_STATE" != "inactive" && "$SYS_SVC_STATE" != "dead" && "$SYS_SVC_STATE" != "failed" ]]; then
                echo -e "\033[1;31m[ac] system agent-core still $SYS_SVC_STATE after stop -- aborting\033[0m" >&2
                exit 1
            fi
        fi

        SYS_SVC_ENABLED=$(systemctl is-enabled agent-core 2>/dev/null || true)
        if [[ "$SYS_SVC_ENABLED" != "disabled" && "$SYS_SVC_ENABLED" != "masked" && "$SYS_SVC_ENABLED" != "static" ]]; then
            echo -e "\033[1;36m[ac] Disabling system agent-core service ($SYS_SVC_ENABLED)...\033[0m" >&2
            if ! sudo -n systemctl disable agent-core 2>/dev/null; then
                echo -e "\033[1;31m[ac] Unable to disable system agent-core service. Run: sudo systemctl disable agent-core\033[0m" >&2
                exit 1
            fi
        fi
    fi
fi
if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files --type=service 2>/dev/null | awk '{print $1}' | grep -qx "agent-core.service"; then
    AC_SVC_ENABLED=$(systemctl --user is-enabled agent-core 2>/dev/null || true)
    if [[ "$AC_SVC_ENABLED" == masked* ]]; then
        AC_USER_SVC_WAS_MASKED=true
    fi

    AC_SVC_STATE=$(systemctl --user is-active agent-core 2>/dev/null || true)
    if [[ "$AC_SVC_STATE" != "inactive" && "$AC_SVC_STATE" != "dead" && "$AC_SVC_STATE" != "failed" ]]; then
        echo -e "\033[1;36m[ac] Stopping systemd agent-core service ($AC_SVC_STATE)...\033[0m" >&2
        systemctl --user stop agent-core 2>/dev/null || true
    fi
    # Wait until fully stopped (up to 10s)
    for _i in $(seq 1 20); do
        AC_SVC_STATE=$(systemctl --user is-active agent-core 2>/dev/null || true)
        [[ "$AC_SVC_STATE" == "inactive" || "$AC_SVC_STATE" == "dead" || "$AC_SVC_STATE" == "failed" ]] && break
        sleep 0.5
    done
    AC_SVC_STATE=$(systemctl --user is-active agent-core 2>/dev/null || true)
    if [[ "$AC_SVC_STATE" != "inactive" && "$AC_SVC_STATE" != "dead" && "$AC_SVC_STATE" != "failed" ]]; then
        echo -e "\033[1;31m[ac] systemd agent-core still $AC_SVC_STATE after stop -- aborting\033[0m" >&2
        exit 1
    fi

    # Prevent systemd from starting the service during self-test (Restart=always
    # can respawn while ports are being freed).
    if [[ "$AC_USER_SVC_WAS_MASKED" != "true" ]]; then
        echo -e "\033[1;36m[ac] Masking systemd agent-core service for self-test...\033[0m" >&2
        systemctl --user mask --runtime agent-core 2>/dev/null || true
        AC_USER_SVC_RUNTIME_MASKED=true
    fi
    # Clear restart counters and any lingering state to prevent delayed cgroup ops.
    systemctl --user reset-failed agent-core 2>/dev/null || true
fi

# Nuke: kill all remaining agent-core processes (excluding this script)
SELF_PID=$$
if pgrep -x "agent-core" > /dev/null 2>&1; then
    echo -e "\033[1;36m[ac] Killing existing agent-core processes...\033[0m" >&2
    # Kill only actual agent-core binaries, not scripts whose paths contain "agent-core"
    pgrep -x "agent-core" | while read -r pid; do
        [[ "$pid" -eq "$SELF_PID" ]] && continue
        kill "$pid" 2>/dev/null || true
    done
    sleep 0.5
    # Ensure hard kill if anything survived
    pgrep -x "agent-core" | while read -r pid; do
        [[ "$pid" -eq "$SELF_PID" ]] && continue
        kill -9 "$pid" 2>/dev/null || true
    done
    sleep 0.5
fi

# Kill Zee gateway processes too (they aren't named "agent-core")
if pgrep -af "zee.*gateway" > /dev/null 2>&1; then
    echo -e "\033[1;36m[ac] Killing orphaned Zee gateway processes...\033[0m" >&2
    pkill -9 -f "zee.*gateway" 2>/dev/null || true
fi

# Clean up stale daemon state left by kill -9
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-core/daemon"
rm -f "$STATE_DIR/daemon.pid" "$STATE_DIR/daemon.lock" 2>/dev/null

# Ensure daemon port is free. Retries up to 3 times with escalating signals.
# Uses lsof, falls back to ss+fuser when lsof is unavailable.
ensure_port_free() {
    local port=$1
    local attempt
    for attempt in 1 2 3; do
        local pids=""
        if command -v lsof >/dev/null 2>&1; then
            pids=$(lsof -ti:"$port" 2>/dev/null || true)
        elif command -v ss >/dev/null 2>&1; then
            pids=$(ss -tlnp "sport = :$port" 2>/dev/null \
                | grep -oP 'pid=\K[0-9]+' | sort -u || true)
        fi
        if [[ -z "$pids" ]]; then
            return 0
        fi
        local sig="TERM"
        [[ "$attempt" -ge 2 ]] && sig="KILL"
        echo -e "\033[1;33m[ac] Port $port in use (PID: $(echo $pids | tr '\n' ' ')), sending SIG$sig (attempt $attempt)...\033[0m" >&2
        for pid in $pids; do
            [[ "$pid" -eq "$$" ]] && continue
            kill -"$sig" "$pid" 2>/dev/null || true
        done
        sleep 1
    done
    # Final check
    local remaining=""
    if command -v lsof >/dev/null 2>&1; then
        remaining=$(lsof -ti:"$port" 2>/dev/null || true)
    elif command -v ss >/dev/null 2>&1; then
        remaining=$(ss -tlnp "sport = :$port" 2>/dev/null \
            | grep -oP 'pid=\K[0-9]+' | sort -u || true)
    fi
    if [[ -n "$remaining" ]]; then
        echo -e "\033[1;31m[ac] FATAL: port $port still held by PID $remaining after 3 attempts\033[0m" >&2
        return 1
    fi

    # Explicitly return success. Without this, the function may inherit the exit
    # status of the last `[[ ... ]]` check (typically 1 when the port is free),
    # causing `ac dev` to exit before launching the TUI.
    return 0
}

ensure_port_free "$DAEMON_PORT" || exit 1

# ---------------------------------------------------------------------------
# Regression tests (fail fast)
# ---------------------------------------------------------------------------

echo -e "\033[1;36m[ac] Running tests...\033[0m" >&2
(cd "$REPO_ROOT" && bun test) || { echo "[ac] Tests failed"; exit 1; }

# ---------------------------------------------------------------------------
# Self-test: start headless daemon, verify providers + messaging, then open TUI
# ---------------------------------------------------------------------------

if [[ "$SKIP_TEST" == "true" ]]; then
    echo -e "\033[1;33m[ac] Skipping self-test (--skip-test)\033[0m" >&2
    if [[ "$AC_USER_SVC_RUNTIME_MASKED" == "true" ]]; then
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user unmask agent-core 2>/dev/null || true
        fi
        AC_USER_SVC_RUNTIME_MASKED=false
    fi
    if [[ "$NO_TUI" == "true" ]]; then
        echo -e "\033[1;32m[ac] Self-tests skipped; service started. (No TUI: --no-tui)\033[0m" >&2
        exit 0
    fi
    exec "$LOCAL_BINARY" "${PASSTHROUGH_ARGS[@]}"
fi

# Resolve gateway auth token from zee config so daemon<->gateway RPC works.
# The daemon uses ZEE_GATEWAY_TOKEN or a token file (ZEE_GATEWAY_TOKEN_FILE, default: ~/.local/state/agent-core/zee_gateway_token).
ZEE_CONFIG="${HOME}/.zee/zee.json"
if [[ -f "$ZEE_CONFIG" ]] && command -v jq &>/dev/null; then
    # Try direct jq first (standard JSON), fall back to comment-stripped for JSON5.
    # The old sed 's|//.*||' mangled URLs containing // (e.g. ws://...).
    # The fallback deletes only full-line // comments and inline /* */ blocks.
    GW_TOKEN=$(jq -r '.gateway.auth.token // empty' "$ZEE_CONFIG" 2>/dev/null) || \
    GW_TOKEN=$(sed '/^\s*\/\//d; s|/\*.*\*/||g' "$ZEE_CONFIG" 2>/dev/null | jq -r '.gateway.auth.token // empty' 2>/dev/null) || \
    GW_TOKEN=""
    if [[ -n "$GW_TOKEN" ]]; then
        export ZEE_GATEWAY_TOKEN="$GW_TOKEN"
    fi
fi

DAEMON_URL="http://127.0.0.1:$DAEMON_PORT"
TEST_DAEMON_PID=""
AC_TEST_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/agent-core/ac-test.json"
DAEMON_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/agent-core/daemon.env"

# Run self-tests with the same environment as the systemd service.
# This prevents false-green tests when keys are only in the shell env.
DAEMON_ENV_BASE=(
    env -i
    HOME="$HOME"
    USER="${USER:-$(id -un)}"
    LOGNAME="${LOGNAME:-$USER}"
    PATH="$PATH"
    NODE_ENV=production
    AGENT_CORE_ROOT="$MONOREPO_ROOT"
    AGENT_CORE_HEADLESS=1
)
# Source daemon.env first, then override ZEE_GATEWAY_TOKEN after so the
# correct token from zee.json always wins over any stale daemon.env value.
if [[ -f "$DAEMON_ENV_FILE" ]] && [[ -n "${ZEE_GATEWAY_TOKEN:-}" ]]; then
    DAEMON_ENV_PREFIX=("${DAEMON_ENV_BASE[@]}" bash -c 'set -a; source "$1"; set +a; export ZEE_GATEWAY_TOKEN="$2"; shift 2; exec "$@"' _ "$DAEMON_ENV_FILE" "$ZEE_GATEWAY_TOKEN")
elif [[ -f "$DAEMON_ENV_FILE" ]]; then
    DAEMON_ENV_PREFIX=("${DAEMON_ENV_BASE[@]}" bash -c 'set -a; source "$0"; set +a; exec "$@"' "$DAEMON_ENV_FILE")
elif [[ -n "${ZEE_GATEWAY_TOKEN:-}" ]]; then
    DAEMON_ENV_PREFIX=("${DAEMON_ENV_BASE[@]}" bash -c 'export ZEE_GATEWAY_TOKEN="$1"; shift; exec "$@"' _ "$ZEE_GATEWAY_TOKEN")
else
    DAEMON_ENV_PREFIX=("${DAEMON_ENV_BASE[@]}" bash -c 'exec "$@"' bash)
fi

ac_test_cleanup() {
    if [[ -n "$TEST_DAEMON_PID" ]] && kill -0 "$TEST_DAEMON_PID" 2>/dev/null; then
        kill "$TEST_DAEMON_PID" 2>/dev/null || true
        wait "$TEST_DAEMON_PID" 2>/dev/null || true
    fi
    if [[ -n "$DAEMON_WATCHER_PID" ]] && kill -0 "$DAEMON_WATCHER_PID" 2>/dev/null; then
        kill "$DAEMON_WATCHER_PID" 2>/dev/null || true
        wait "$DAEMON_WATCHER_PID" 2>/dev/null || true
    fi
    # Clean state so TUI can start fresh
    rm -f "$STATE_DIR/daemon.pid" "$STATE_DIR/daemon.lock" 2>/dev/null
}

ac_test_fail() {
    echo -e "\033[1;31m[ac] SELF-TEST FAILED: $1\033[0m" >&2
    echo -e "\033[1;31m[ac] TUI will NOT open. Fix the issue and retry, or use: ac dev --skip-test\033[0m" >&2
    exit 1
}

DAEMON_WATCHER_PID=""

start_test_daemon() {
    echo -e "\033[1;33m[ac] Starting headless daemon for self-test...\033[0m" >&2
    ("${DAEMON_ENV_PREFIX[@]}" "$LOCAL_BINARY" daemon --directory "$MONOREPO_ROOT") &
    TEST_DAEMON_PID=$!
    # Background watcher: report the exit signal if the daemon dies unexpectedly.
    (
        wait "$TEST_DAEMON_PID" 2>/dev/null
        EC=$?
        if [[ $EC -gt 128 ]]; then
            SIG=$((EC - 128))
            echo -e "\033[1;31m[ac] Daemon (PID $TEST_DAEMON_PID) killed by signal $SIG\033[0m" >&2
        elif [[ $EC -ne 0 ]]; then
            echo -e "\033[1;31m[ac] Daemon (PID $TEST_DAEMON_PID) exited with code $EC\033[0m" >&2
        fi
    ) &
    DAEMON_WATCHER_PID=$!
}

wait_for_daemon_health() {
    local max_wait="${1:-30}"
    echo -e "\033[1;33m[ac] Waiting for daemon health...\033[0m" >&2
    local waited=0
    while true; do
        if curl -sf -m 2 "$DAEMON_URL/global/health" 2>/dev/null | jq -e '.healthy' >/dev/null 2>&1; then
            break
        fi
        if [[ -n "$TEST_DAEMON_PID" ]] && ! kill -0 "$TEST_DAEMON_PID" 2>/dev/null; then
            ac_test_fail "daemon process died during startup"
        fi
        sleep 1
        waited=$((waited + 1))
        if [[ "$waited" -ge "$max_wait" ]]; then
            ac_test_fail "daemon not healthy after ${max_wait}s"
        fi
    done
    echo -e "\033[1;32m[ac] Daemon healthy\033[0m" >&2
}

wait_for_gateway_ready() {
    local max_wait="${1:-30}"
    echo -e "\033[1;33m[ac] Waiting for gateway...\033[0m" >&2
    local waited=0
    local last_err=""
    local err=""
    local gw_restart_attempted=false
    while true; do
        # The server-side gateway RPC check can take up to ~10s (WS connect + method call).
        # Use a slightly longer client timeout to avoid piling up timed-out requests.
        #
        # NOTE: /gateway/status bridges the gateway's "health" method which can be slow on
        # cold start. /gateway/channels/status is a faster reachability signal.
        GW_STATUS=$(curl -sS -m 12 "$DAEMON_URL/gateway/channels/status" 2>/dev/null || true)
        if echo "$GW_STATUS" | jq -e '.success' >/dev/null 2>&1; then
            break
        fi
        # Fail fast if daemon died (instead of polling a dead server for 30s).
        if [[ -n "$TEST_DAEMON_PID" ]] && ! kill -0 "$TEST_DAEMON_PID" 2>/dev/null; then
            if [[ "$gw_restart_attempted" != "true" ]]; then
                echo -e "\033[1;33m[ac] Daemon died during gateway wait; restarting once...\033[0m" >&2
                gw_restart_attempted=true
                TEST_DAEMON_PID=""
                rm -f "$STATE_DIR/daemon.pid" "$STATE_DIR/daemon.lock" 2>/dev/null
                ensure_port_free "$DAEMON_PORT" || ac_test_fail "port still in use after daemon died"
                start_test_daemon
                wait_for_daemon_health 30
                waited=0
                last_err=""
                continue
            fi
            ac_test_fail "daemon process died while waiting for gateway (after restart)"
        fi
        err=$(echo "$GW_STATUS" | jq -r '.error // empty' 2>/dev/null || true)
        if [[ -n "$err" && "$err" != "$last_err" ]]; then
            echo -e "\033[1;33m[ac] Gateway status error: ${err}\033[0m" >&2
            last_err="$err"
        fi
        sleep 1
        waited=$((waited + 1))
        if [[ "$waited" -ge "$max_wait" ]]; then
            if [[ -n "$err" ]]; then
                ac_test_fail "gateway not ready after ${max_wait}s (last error: ${err})"
            fi
            ac_test_fail "gateway not ready after ${max_wait}s"
        fi
    done
    echo -e "\033[1;32m[ac] Gateway ready\033[0m" >&2
}

wait_for_whatsapp_ready() {
    local requested_account="${1:-}"
    local max_wait="${2:-45}"

    echo -e "\033[1;33m[ac] Waiting for WhatsApp connection...\033[0m" >&2

    local waited=0
    local last_state=""
    local last_error=""
    local ch_status=""

    while true; do
        ch_status=$(curl -sf -m 7 "$DAEMON_URL/gateway/channels/status" 2>/dev/null || true)
        if echo "$ch_status" | jq -e '.success' >/dev/null 2>&1; then
            local default_account=""
            default_account=$(echo "$ch_status" | jq -r '.data.channelDefaultAccountId.whatsapp // empty' 2>/dev/null || true)

            local resolved_account=""
            if [[ -n "$requested_account" ]]; then
                local has_requested=""
                has_requested=$(echo "$ch_status" | jq -r --arg acc "$requested_account" '(.data.channelAccounts.whatsapp // []) | any(.accountId == $acc)' 2>/dev/null || echo "false")
                if [[ "$has_requested" == "true" ]]; then
                    resolved_account="$requested_account"
                fi
            fi
            if [[ -z "$resolved_account" && -n "$default_account" ]]; then
                resolved_account="$default_account"
            fi
            if [[ -z "$resolved_account" ]]; then
                resolved_account=$(echo "$ch_status" | jq -r '(.data.channelAccounts.whatsapp // [])[0].accountId // empty' 2>/dev/null || true)
            fi
            if [[ -z "$resolved_account" ]]; then
                resolved_account="default"
            fi
            WA_ACCOUNT_EFFECTIVE="$resolved_account"

            local state=""
            state=$(echo "$ch_status" | jq -r --arg acc "$resolved_account" '
                (.data.channelAccounts.whatsapp // []) as $accounts |
                ($accounts | map(select(.accountId == $acc)) | .[0]) as $snap |
                if $snap == null then "missing"
                elif ($snap.enabled == false) then "disabled"
                elif ($snap.configured == false) then "unconfigured"
                elif ($snap.linked == false) then "unlinked"
                elif ($snap.running == false) then "stopped"
                elif ($snap.connected == true) then "ready"
                else "connecting"
                end
            ' 2>/dev/null || echo "unknown")

            local err=""
            err=$(echo "$ch_status" | jq -r --arg acc "$resolved_account" '
                (.data.channelAccounts.whatsapp // []) as $accounts |
                ($accounts | map(select(.accountId == $acc)) | .[0]) as $snap |
                if $snap == null then "" else ($snap.lastError // "") end
            ' 2>/dev/null || echo "")

            if [[ "$state" == "ready" ]]; then
                return 0
            fi

            if [[ "$state" != "$last_state" || "$err" != "$last_error" ]]; then
                if [[ -n "$err" ]]; then
                    echo -e "\033[1;33m[ac] WhatsApp status: account=${resolved_account} state=${state} error=${err}\033[0m" >&2
                else
                    echo -e "\033[1;33m[ac] WhatsApp status: account=${resolved_account} state=${state}\033[0m" >&2
                fi
                last_state="$state"
                last_error="$err"
            fi
        fi

        sleep 1
        waited=$((waited + 1))
        if [[ "$waited" -ge "$max_wait" ]]; then
            echo -e "\033[1;31m[ac] WhatsApp not ready after ${max_wait}s (account=${WA_ACCOUNT_EFFECTIVE:-unknown})\033[0m" >&2
            if [[ -n "$ch_status" ]]; then
                echo -e "\033[1;31m[ac] WhatsApp snapshot: $(echo "$ch_status" | jq -c --arg acc "${WA_ACCOUNT_EFFECTIVE:-}" '(.data.channelAccounts.whatsapp // []) | map(select(.accountId == $acc)) | .[0] // null' 2>/dev/null || echo "null")\033[0m" >&2
            fi
            echo -e "\033[1;31m[ac] Link WhatsApp (if needed): zee channels login --channel whatsapp --account ${WA_ACCOUNT_EFFECTIVE:-default}\033[0m" >&2
            return 1
        fi
    done
}

restart_test_daemon_if_dead() {
    if [[ -z "$TEST_DAEMON_PID" ]]; then
        return 0
    fi
    if kill -0 "$TEST_DAEMON_PID" 2>/dev/null; then
        return 0
    fi
    echo -e "\033[1;33m[ac] Warning: daemon died during self-test; restarting once...\033[0m" >&2
    TEST_DAEMON_PID=""
    rm -f "$STATE_DIR/daemon.pid" "$STATE_DIR/daemon.lock" 2>/dev/null
    ensure_port_free "$DAEMON_PORT" || ac_test_fail "daemon port still in use after daemon died"
    start_test_daemon
    wait_for_daemon_health 30
    wait_for_gateway_ready 30
}

restart_test_daemon_force() {
    echo -e "\033[1;33m[ac] Restarting daemon (retry)...\033[0m" >&2
    if [[ -n "$TEST_DAEMON_PID" ]] && kill -0 "$TEST_DAEMON_PID" 2>/dev/null; then
        kill "$TEST_DAEMON_PID" 2>/dev/null || true
        wait "$TEST_DAEMON_PID" 2>/dev/null || true
    fi
    TEST_DAEMON_PID=""
    rm -f "$STATE_DIR/daemon.pid" "$STATE_DIR/daemon.lock" 2>/dev/null
    ensure_port_free "$DAEMON_PORT" || ac_test_fail "daemon port still in use after daemon restart"
    start_test_daemon
    wait_for_daemon_health 30
    wait_for_gateway_ready 30
}

# Provider health check (real API calls with tokens)
echo -e "\033[1;33m[ac] Running provider health check...\033[0m" >&2
if ! (cd "$REPO_ROOT" && "${DAEMON_ENV_PREFIX[@]}" bun run script/provider-health-check.ts --errors-only --critical-only); then
    ac_test_fail "provider health check failed (token/API issue)"
fi
echo -e "\033[1;32m[ac] Providers OK\033[0m" >&2

# Start daemon in headless mode (after provider checks to reduce peak memory usage)
start_test_daemon
wait_for_daemon_health 30
wait_for_gateway_ready 30

# Memory health check (ensures embedding + vector store are available)
echo -e "\033[1;33m[ac] Checking memory health...\033[0m" >&2
restart_test_daemon_if_dead
MEM_STATUS=$(curl -sf -m 5 "$DAEMON_URL/memory/health" 2>/dev/null || true)
if ! echo "$MEM_STATUS" | jq -e '.available == true' >/dev/null 2>&1; then
    ac_test_fail "memory backend unavailable (check memory.embedding credentials and Qdrant)"
fi
echo -e "\033[1;32m[ac] Memory OK\033[0m" >&2

# Messaging test
MESSAGING_FAILED=false

if [[ -f "$AC_TEST_CONFIG" ]]; then
    WA_TO=$(jq -r '.whatsapp.to // empty' "$AC_TEST_CONFIG" 2>/dev/null)
    WA_ACCOUNT=$(jq -r '.whatsapp.account // "default"' "$AC_TEST_CONFIG" 2>/dev/null)
    MX_ROOM_ID=$(jq -r '.matrix.roomId // empty' "$AC_TEST_CONFIG" 2>/dev/null)
    MX_ACCOUNT=$(jq -r '.matrix.account // "zee"' "$AC_TEST_CONFIG" 2>/dev/null)

    # WhatsApp: "Zee is back on."
    if [[ -n "$WA_TO" ]]; then
        echo -e "\033[1;33m[ac] WhatsApp test -> $WA_TO ...\033[0m" >&2
        restart_test_daemon_if_dead
        if ! wait_for_whatsapp_ready "$WA_ACCOUNT" 60; then
            echo -e "\033[1;31m[ac] WhatsApp FAILED: channel not ready\033[0m" >&2
            MESSAGING_FAILED=true
        else
            WA_HTTP_CODE=""
            WA_HTTP_BODY=""
            send_whatsapp_once() {
                local payload out code body
                payload=$(
                    jq -nc \
                        --arg chatId "$WA_TO" \
                        --arg message "Zee is back on." \
                        --arg accountId "${WA_ACCOUNT_EFFECTIVE:-$WA_ACCOUNT}" \
                        '{chatId:$chatId,message:$message,accountId:$accountId}'
                )

                out=$(curl -sS -m 20 "$DAEMON_URL/gateway/whatsapp/send" \
                    -H "Content-Type: application/json" \
                    -d "$payload" \
                    -w "\n%{http_code}" 2>&1) || true
                code=$(printf '%s' "$out" | tail -n1)
                body=$(printf '%s' "$out" | sed '$d')
                if [[ ! "$code" =~ ^[0-9]{3}$ ]]; then
                    body="$out"
                    code="000"
                fi
                WA_HTTP_CODE="$code"
                WA_HTTP_BODY="$body"
            }

            WA_RESULT=""
            WA_SENT=false
            backoff=1
            for attempt in 1 2 3; do
                send_whatsapp_once
                WA_RESULT="$WA_HTTP_BODY"

                if [[ "$WA_HTTP_CODE" == "200" ]] && echo "$WA_RESULT" | jq -e '.success == true' >/dev/null 2>&1; then
                    WA_SENT=true
                    break
                fi

                if echo "$WA_RESULT" | grep -q "No active WhatsApp Web listener"; then
                    # Gateway can be healthy while WhatsApp is still connecting.
                    wait_for_whatsapp_ready "$WA_ACCOUNT" 30 || true
                fi

                if [[ "$attempt" -lt 3 ]]; then
                    echo -e "\033[1;33m[ac] WhatsApp send failed (http=${WA_HTTP_CODE}); retrying...\033[0m" >&2
                    sleep "$backoff"
                    backoff=$((backoff * 2))
                fi
            done

            if [[ "$WA_SENT" == "true" ]]; then
                echo -e "\033[1;32m[ac] WhatsApp: sent\033[0m" >&2
            else
                echo -e "\033[1;31m[ac] WhatsApp FAILED: ${WA_RESULT:-no response}\033[0m" >&2
                MESSAGING_FAILED=true
            fi
        fi
    else
        echo -e "\033[1;31m[ac] ac-test.json missing whatsapp.to\033[0m" >&2
        MESSAGING_FAILED=true
    fi

    # Matrix
    if [[ -n "$MX_ROOM_ID" ]]; then
        echo -e "\033[1;33m[ac] Matrix test -> $MX_ROOM_ID ...\033[0m" >&2
        MX_RESULT=$(curl -sf -m 15 "$DAEMON_URL/gateway/matrix/send" \
            -H "Content-Type: application/json" \
            -d "{\"roomId\":\"$MX_ROOM_ID\",\"message\":\"Zee is back on.\",\"accountId\":\"$MX_ACCOUNT\"}" 2>&1) || true
        if echo "$MX_RESULT" | jq -e '.success' >/dev/null 2>&1; then
            echo -e "\033[1;32m[ac] Matrix: sent\033[0m" >&2
        else
            echo -e "\033[1;31m[ac] Matrix FAILED: ${MX_RESULT:-no response}\033[0m" >&2
            MESSAGING_FAILED=true
        fi
    else
        echo -e "\033[1;33m[ac] Matrix: skipped (no matrix.roomId in ac-test.json)\033[0m" >&2
    fi
else
    ac_test_fail "no test config at $AC_TEST_CONFIG -- create it with:\n  {\"whatsapp\":{\"to\":\"<jid>@c.us\",\"account\":\"zee\"},\"matrix\":{\"roomId\":\"!roomid:example.org\",\"account\":\"zee\"}}"
fi

if [[ "$MESSAGING_FAILED" == "true" ]]; then
    ac_test_fail "messaging verification failed"
fi

echo -e "\033[1;32m[ac] All self-tests passed\033[0m" >&2

# Stop test daemon cleanly and ensure port is free before systemd restart
echo -e "\033[1;33m[ac] Stopping test daemon...\033[0m" >&2
kill "$TEST_DAEMON_PID" 2>/dev/null || true
wait "$TEST_DAEMON_PID" 2>/dev/null || true
TEST_DAEMON_PID=""
if [[ -n "$DAEMON_WATCHER_PID" ]]; then
    kill "$DAEMON_WATCHER_PID" 2>/dev/null || true
    wait "$DAEMON_WATCHER_PID" 2>/dev/null || true
    DAEMON_WATCHER_PID=""
fi
rm -f "$STATE_DIR/daemon.pid" "$STATE_DIR/daemon.lock" 2>/dev/null

# Verify port is released before handing off to systemd (prevents crash-loop)
ensure_port_free "$DAEMON_PORT" || exit 1

# Start systemd service (if installed) so TUI attaches to it
if command -v systemctl >/dev/null 2>&1; then
    if systemctl --user list-unit-files --type=service 2>/dev/null | awk '{print $1}' | grep -qx "agent-core.service"; then
        if [[ "$AC_USER_SVC_RUNTIME_MASKED" == "true" ]]; then
            systemctl --user unmask agent-core 2>/dev/null || true
            AC_USER_SVC_RUNTIME_MASKED=false
        fi

        echo -e "\033[1;36m[ac] Starting systemd agent-core service...\033[0m" >&2
        systemctl --user daemon-reload 2>/dev/null || true
        systemctl --user reset-failed agent-core 2>/dev/null || true
        systemctl --user restart agent-core || { echo "[ac] systemd start failed"; exit 1; }
        sleep 1
        if ! systemctl --user is-active agent-core &>/dev/null; then
            echo "[ac] systemd agent-core is not active" >&2
            exit 1
        fi
    fi
fi

# Boot: run the local binary (starts daemon + gateway + TUI), unless --no-tui.
if [[ "$NO_TUI" == "true" ]]; then
    echo -e "\033[1;32m[ac] Pristine start complete; systemd service is running. (No TUI: --no-tui)\033[0m" >&2
    exit 0
fi
echo -e "\033[1;32m[ac] Launching TUI...\033[0m" >&2
exec "$LOCAL_BINARY" "${PASSTHROUGH_ARGS[@]}"
