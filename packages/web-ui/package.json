{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zee/web-ui",
  "version": "1.0.0",
  "description": "Reusable web chat component package for Zee",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsgo"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mariozechner/pi-web-ui": "0.52.9",
    "@zee/agent-core": "workspace:*",
    "@zee/ai": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "publishConfig": {
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adolago/zee.git",
    "directory": "packages/web-ui"
  },
  "keywords": [
    "zee",
    "web-ui",
    "chat",
    "components",
    "assistant"
  ]
}
