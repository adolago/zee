{
  "name": "zee-vscode",
  "displayName": "Zee",
  "description": "VS Code integration for Zee sessions and prompts.",
  "version": "0.1.0",
  "publisher": "adolago",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zee.connect",
        "title": "Zee: Connect to Daemon"
      },
      {
        "command": "zee.newSession",
        "title": "Zee: New Session"
      },
      {
        "command": "zee.sendPrompt",
        "title": "Zee: Send Prompt"
      },
      {
        "command": "zee.sendSelection",
        "title": "Zee: Send Selection"
      }
    ],
    "configuration": {
      "title": "Zee",
      "properties": {
        "zee.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3210",
          "description": "Base URL for the zee daemon."
        }
      }
    }
  },
  "activationEvents": [
    "onCommand:zee.connect",
    "onCommand:zee.newSession",
    "onCommand:zee.sendPrompt",
    "onCommand:zee.sendSelection"
  ]
}
