#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CORE_BINARY="${ZEE_CORE_BINARY:-$REPO_ROOT/dist/@adolago/zee-linux-x64/bin/zee}"
SWABBLE_CLI="$REPO_ROOT/Swabble/zee.mjs"

if [[ $# -eq 0 ]]; then
  if [[ -x "$CORE_BINARY" ]]; then
    exec "$CORE_BINARY"
  fi
fi

case "${1-}" in
  pairing)
    if [[ ! -f "$SWABBLE_CLI" ]]; then
      echo "Pairing command unavailable: missing Swabble CLI at $SWABBLE_CLI" >&2
      exit 1
    fi
    if ! command -v node >/dev/null 2>&1; then
      echo "Pairing command requires node, but node was not found in PATH" >&2
      exit 1
    fi
    exec node "$SWABBLE_CLI" "$@"
    ;;
  *)
    if [[ ! -x "$CORE_BINARY" ]]; then
      echo "zee core binary not found or not executable: $CORE_BINARY" >&2
      echo "Run: cd packages/zee && bun run build" >&2
      exit 1
    fi
    exec "$CORE_BINARY" "$@"
    ;;
esac
