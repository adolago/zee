# =============================================================================
# Zee Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All values shown are defaults - only set what you need to override.

# =============================================================================
# LLM Provider API Keys (at least one required)
# =============================================================================

# Anthropic (Claude) - Primary provider
ANTHROPIC_API_KEY=

# OpenAI - Required for embeddings, optional for LLM
OPENAI_API_KEY=

# OpenRouter - Alternative provider with multiple models
OPENROUTER_API_KEY=

# Voyage AI - Alternative embedding provider
VOYAGE_API_KEY=

# =============================================================================
# Vector Database (Qdrant -- local only, remote not supported)
# =============================================================================

# Qdrant server URL (must be localhost)
# Default: http://localhost:6333
QDRANT_URL=http://localhost:6333

# =============================================================================
# Daemon Configuration
# =============================================================================

# Daemon port for API access
# Default: 3456
ZEE_DAEMON_PORT=3456

# IPC socket path for inter-process communication
# Default: /tmp/zee.sock (Linux) or platform equivalent
# ZEE_IPC_SOCKET=/tmp/zee.sock

# Enable WezTerm pane integration
# Default: false
# ZEE_WEZTERM_ENABLED=true
# PERSONAS_WEZTERM_ENABLED=true

# =============================================================================
# Personas Configuration
# =============================================================================

# Default persona to use (zee, stanley, johny)
# Default: zee
PERSONAS_LEAD_PERSONA=zee

# =============================================================================
# Stanley (Investing Persona) - Optional
# =============================================================================

# Stanley repository path
# Default: ~/Repositories/personas/stanley
# STANLEY_REPO=/path/to/stanley

# Stanley CLI script path
# Default: $STANLEY_REPO/scripts/stanley_cli.py
# STANLEY_CLI=/path/to/stanley_cli.py

# Python interpreter for Stanley
# Default: Uses venv if available, else python3
# STANLEY_PYTHON=python3

# Financial data providers
PLAID_CLIENT_ID=
PLAID_SECRET=
ALPHA_VANTAGE_API_KEY=
YAHOO_FINANCE_KEY=

# =============================================================================
# Johny (Learning Persona) - Optional
# =============================================================================

# Johny repository path
# Default: ~/Repositories/personas/johny
# JOHNY_REPO=/path/to/johny

# Johny CLI script path
# Default: $JOHNY_REPO/scripts/johny_cli.py
# JOHNY_CLI=/path/to/johny_cli.py

# Python interpreter for Johny
# Default: Uses venv if available, else python3
# JOHNY_PYTHON=python3

# =============================================================================
# Zee (Personal Assistant Persona) - Optional
# =============================================================================

# WhatsApp (wacli personal bridge)
# WACLI_BIN=/home/artur/go/bin/wacli
# WACLI_STORE=/home/artur/.wacli
# ZEE_WA_UPDATE_TO=436649137379@s.whatsapp.net
# ZEE_WA_CALENDAR_TO=436649137379@s.whatsapp.net

# Telegram Bot
TELEGRAM_BOT_TOKEN=
# Keep ops notifications on a dedicated chat id (not your conversation chat).
# ZEE_TELEGRAM_UPDATE_TO=123456789
# ZEE_TELEGRAM_CALENDAR_TO=123456789
# ZEE_TELEGRAM_HEARTBEAT_TO=123456789
# MiniMax TTS (used by Telegram `/speak`)
# MINIMAX_API_KEY=
# Optional Zee Telegram bridge settings (scripts/telegram-bridge)
# ZEE_TELEGRAM_AGENT=zee
# ZEE_TELEGRAM_SESSION_SURFACE=api
# ZEE_TELEGRAM_STATE=~/.local/state/zee/telegram-bridge.json
# ZEE_TELEGRAM_POLL_TIMEOUT=30
# Restrict bridge inbound traffic to conversation chat ids only.
# ZEE_TELEGRAM_ALLOWED_CHAT_IDS=123456789
# ZEE_API_TOKEN=

# Notification routing for cron helper scripts:
# whatsapp | telegram
# ZEE_NOTIFY_CHANNEL=telegram
# Upstream gap reports are disabled by default; set true to re-enable.
# ZEE_UPSTREAM_REPORTS_ENABLED=false

# Heartbeat/Cron delivery target override:
# ZEE_HEARTBEAT_DELIVERY_CHANNEL=telegram
# ZEE_HEARTBEAT_DELIVERY_TO=123456789

# =============================================================================
# GitHub Integration
# =============================================================================

# GitHub token for repository operations
# Can also use GH_TOKEN
GITHUB_TOKEN=

# =============================================================================
# Terminal Integration
# =============================================================================

# Preferred terminal for canvas/panes: wezterm, tmux, or auto
# Default: auto (detects available terminal)
# CANVAS_TERMINAL=wezterm

# =============================================================================
# TUWEL Integration (Optional)
# =============================================================================
TUWEL_EMAIL=
TUWEL_PASSWORD=

# =============================================================================
# Development/Debug
# =============================================================================

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Enable verbose output
# DEBUG=true
