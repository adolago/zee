#!/bin/sh
# Check if bun version satisfies package.json engines.bun
EXPECTED_RANGE=$(bun -e 'const pkg = await Bun.file("package.json").json(); console.log(pkg.engines?.bun ?? "")')
CURRENT_VERSION=$(bun --version)

if [ -z "$EXPECTED_RANGE" ]; then
  echo "Error: engines.bun is not set in package.json"
  exit 1
fi

if ! CURRENT_VERSION="$CURRENT_VERSION" EXPECTED_RANGE="$EXPECTED_RANGE" bun -e 'import { satisfies } from "semver"; if (!satisfies(process.env.CURRENT_VERSION ?? "", process.env.EXPECTED_RANGE ?? "")) process.exit(1)'; then
  echo "Error: Bun version $CURRENT_VERSION does not satisfy expected range $EXPECTED_RANGE from package.json"
  exit 1
fi

./scripts/verify-skills.sh

bun typecheck
