{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@adolago/zee",
  "description": "Zee unified assistant engine for life admin, investing, and learning.",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bun run --cwd packages/zee --conditions=browser src/index.ts",
    "build:zee": "bun run --cwd packages/zee build",
    "verify:binary": "cd packages/zee && bun run build && ./script/verify-binary.sh",
    "check:legacy-strings": "bash scripts/check-legacy-strings.sh",
    "boundaries:check": "depcruise --config .dependency-cruiser.cjs --ts-config $(pwd)/packages/zee/tsconfig.json --output-type err packages/zee/src",
    "typecheck": "bun run --cwd packages/zee typecheck",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "hello": "echo 'Hello World!'",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/zee",
      "packages/zee-adapter",
      "packages/plugin",
      "packages/sdk",
      "packages/ui",
      "packages/util",
      "packages/web",
      "packages/hosted"
    ],
    "catalog": {
      "@types/bun": "1.3.5",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
